next-env.d.ts

# openapi — one directory per generated group, written by `npm run generate:openapi`, which
# `npm run build` runs before `next build`. Group ids are derived from each spec's tags and the
# audience of its operations, so they are matched by pattern rather than listed: a new tag or a new
# spec needs no edit here.
#
# The generator emits BOTH .mdx pages and a meta.json per group, so ignore the directories
# rather than a file extension — ignoring only *.mdx previously left the group meta.json
# files tracked, where they drifted whenever GROUP_META changed and were rewritten in place
# by the jsonSchema plugin on every fumadocs-mdx run.
content/docs/openapi/*/
# openapi/index.mdx and openapi/meta.json are hand-written and stay tracked.
