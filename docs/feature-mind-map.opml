        <outline text="MCP Server Endpoints" _note="Model Context Protocol server URLs exposing workflows as AI tools via per-server secret-key paths for automation, embedded, and management surfaces, with dual SSE/streamable transport and API-key/OAuth2 auth.&#10;Notes: Many 2026-07 specs: dual transport, tool authorization, audience binding, optional auth">
          <outline text="/api/automation/{secretKey}/mcp"/>
          <outline text="/api/embedded/{secretKey}/mcp"/>
          <outline text="/api/management/{secretKey}/mcp"/>
          <outline text="fromAi input mapping on McpProjectWorkflow.parameters"/>
          <outline text="MCP OAuth2 + API-key auth, audience binding, tool enable/disable, optional authentication"/>
