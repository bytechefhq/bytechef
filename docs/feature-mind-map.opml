        <outline text="Development Compose Stacks" _note="server/docker-compose.dev.infra.yml starts dev infrastructure (PostgreSQL, Redis, Mailhog) and docker-compose.dev.server.yml runs the whole server in Docker for development.">
          <outline text="dev infra stack (Postgres, Redis, Mailhog)"/>
          <outline text="dev server stack (full server in Docker)"/>
        </outline>
        <outline text="Kubernetes Helm Chart" _note="Single Helm chart (kubernetes/helm/bytechef) deploying the monolith image with deployment, service, ingress, HPA, configmap, secrets, and serviceaccount templates.&#10;Notes: Chart deploys the monolith image docker.bytechef.io/bytechef/bytechef; microservice deployment is achieved by running the EE apps rather than a separate chart in-repo">
          <outline text="Deployment + Service + Ingress"/>
          <outline text="HPA autoscaling"/>
          <outline text="ConfigMap/Secrets"/>
          <outline text="Chart tests"/>
        </outline>
        <outline text="EE Microservices Deployment [EE]" _note="server/ee/apps provides a distributed deployment topology: api-gateway, config-server, and per-concern services (configuration, connection, coordinator, execution, scheduler, webhook, worker) plus AI services (ai-copilot, ai-gateway) and a runtime-job runner.">
          <outline text="api-gateway-app"/>
          <outline text="config-server-app (lockdown-hardened)"/>
          <outline text="configuration-app"/>
          <outline text="connection-app"/>
          <outline text="coordinator-app"/>
          <outline text="execution-app"/>
          <outline text="scheduler-app"/>
          <outline text="webhook-app"/>
          <outline text="worker-app"/>
