data: {"type":"TOOL_CALL_RESULT","content":"[{\"name\":\"cron\",\"description\":\"Runs the workflow on a custom schedule defined by a cron expression.\",\"type\":\"trigger\",\"componentName\":\"schedule\"},{\"name\":\"bookingRescheduled\",\"description\":\"Triggers when a booking is rescheduled.\",\"type\":\"trigger\",\"componentName\":\"calcom\"},{\"name\":\"everyDay\",\"description\":\"Runs the workflow at a set time every day, or only on selected days of the week.\",\"type\":\"trigger\",\"componentName\":\"schedule\"},{\"name\":\"everyMonth\",\"description\":\"Runs the workflow once each month on a chosen day at a specific time.\",\"type\":\"trigger\",\"componentName\":\"schedule\"},{\"name\":\"everyWeek\",\"description\":\"Runs the workflow once each week on a chosen day at a specific time.\",\"type\":\"trigger\",\"componentName\":\"schedule\"},{\"name\":\"interval\",\"description\":\"Runs the workflow repeatedly at a fixed interval (for example, every 5 minutes or every 2 days).\",\"type\":\"trigger\",\"componentName\":\"schedule\"},{\"name\":\"inboundCall\",\"description\":\"Triggers when an inbound voice call is received. Returns TwiML that establishes a WebSocket connection for real-time audio streaming and AI conversation.\",\"type\":\"trigger\",\"componentName\":\"twilio\"},{\"name\":\"inviteeCanceled\",\"description\":\"Triggers when an invitee cancels a scheduled event.\",\"type\":\"trigger\",\"componentName\":\"calendly\"},{\"name\":\"inviteeCreated\",\"description\":\"Triggers when an invitee schedules an event.\",\"type\":\"trigger\",\"componentName\":\"calendly\"},{\"name\":\"autoRespondWithHTTP200\",\"description\":\"The webhook trigger always replies immediately with an HTTP 200 status code in response to any incoming webhook request. This guarantees execution of the webhook trigger, but does not involve any validation of the received request.\",\"type\":\"trigger\",\"componentName\":\"webhook\"},{\"name\":\"awaitWorkflowAndRespond\",\"description\":\"You have the flexibility to set up your preferred response. After a webhook request is received, the webhook trigger enters a waiting state for the workflow's response.\",\"type\":\"trigger\",\"componentName\":\"webhook\"},{\"name\":\"modifiedRow\",\"description\":\"Triggers when an existing row is modified. Rows are tracked by their position, so only rows whose content changes at the same position are reported; rows that are inserted, removed, or moved do not fire the trigger.\",\"type\":\"trigger\",\"componentName\":\"googleSheets\"},{\"name\":\"newComment\",\"description\":\"Triggers when new comment is posted.\",\"type\":\"trigger\",\"componentName\":\"figma\"},{\"name\":\"newEmployee\",\"description\":\"Triggers when a new employee is created.\",\"type\":\"trigger\",\"componentName\":\"bambooHr\"},{\"name\":\"newOrUpdatedEvent\",\"description\":\"Triggers when an event is added or updated.\",\"type\":\"trigger\",\"componentName\":\"googleCalendar\"},{\"name\":\"newOrUpdatedIncident\",\"description\":\"Triggers incident is created or updated.\",\"type\":\"trigger\",\"componentName\":\"pagerDuty\"},{\"name\":\"newPost\",\"description\":\"Triggers when a new post is created by a specific user.\",\"type\":\"trigger\",\"componentName\":\"x\"},{\"name\":\"newResponse\",\"description\":\"Triggers when response is submitted to Google Form.\",\"type\":\"trigger\",\"componentName\":\"googleForms\"},{\"name\":\"newRow\",\"description\":\"Triggers when a new row is added. Rows are tracked by their content, so a row inserted in the middle of the sheet is reported and editing an existing row does not fire the trigger.\",\"type\":\"trigger\",\"componentName\":\"googleSheets\"},{\"name\":\"newTask\",\"description\":\"Triggers when a new task is added.\",\"type\":\"trigger\",\"componentName\":\"googleTasks\"},{\"name\":\"newTask\",\"description\":\"Triggers when new task is created.\",\"type\":\"trigger\",\"componentName\":\"nifty\"},{\"name\":\"updatedEmployee\",\"description\":\"Triggers when specific employee fields are updated.\",\"type\":\"trigger\",\"componentName\":\"bambooHr\"},{\"name\":\"validateAndRespond\",\"description\":\"Upon receiving a webhook request, it goes through a validation process. Once validated, the webhook trigger responds to the sender with an appropriate HTTP status code.\",\"type\":\"trigger\",\"componentName\":\"webhook\"}]","messageId":"6d021029-8d83-4391-b543-113c43a10256","rawEvent":null,"role":"tool","timestamp":1792280255676,"toolCallId":"982aaa9c-c81d-40b9-a755-00fde3a4082d","type":"TOOL_CALL_RESULT"}

