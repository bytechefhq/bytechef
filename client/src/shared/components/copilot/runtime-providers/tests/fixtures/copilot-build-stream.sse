data: {"type":"TOOL_CALL_RESULT","content":"[{\"name\":\"sendChannelMessage\",\"description\":\"Sends a message to a public or private channel.\",\"type\":\"action\",\"componentName\":\"slack\"},{\"name\":\"sendChannelMessage\",\"description\":\"Sends a message to a channel. Sending attachments is supported with Message Text Format is set to \\\"html\\\".\",\"type\":\"action\",\"componentName\":\"microsoftTeams\"},{\"name\":\"sendChannelMessage\",\"description\":\"Send messages to channel on your workspace.\",\"type\":\"action\",\"componentName\":\"rocketchat\"},{\"name\":\"sendApprovalMessage\",\"description\":\"Sends approval message to a channel.\",\"type\":\"action\",\"componentName\":\"slack\"},{\"name\":\"sendChannelMessage\",\"description\":\"Post a new message to a specific #channel you choose.\",\"type\":\"action\",\"componentName\":\"discord\"},{\"name\":\"sendDirectMessage\",\"description\":\"Sends a direct message to another user in a workspace. If it hasn't already, a direct message conversation will be created.\",\"type\":\"action\",\"componentName\":\"slack\"},{\"name\":\"replyToChannelMessage\",\"description\":\"Sends a reply to a channel message. Sending attachments is supported with Message Text Format is set to \\\"html\\\".\",\"type\":\"action\",\"componentName\":\"microsoftTeams\"},{\"name\":\"sendMessage\",\"description\":\"Send message to a channel.\",\"type\":\"action\",\"componentName\":\"mattermost\"},{\"name\":\"sendDirectMessage\",\"description\":\"Send direct message guild member.\",\"type\":\"action\",\"componentName\":\"discord\"},{\"name\":\"sendDirectMessage\",\"description\":\"Sends a direct message in an existing chat. Sending attachments is supported with Message Text Format set to \\\"html\\\".\",\"type\":\"action\",\"componentName\":\"microsoftTeams\"},{\"name\":\"sendDirectMessage\",\"description\":\"Send messages to users on your workspace.\",\"type\":\"action\",\"componentName\":\"rocketchat\"},{\"name\":\"sendDirectMessage\",\"description\":\"Sends a direct message to a specified user.\",\"type\":\"action\",\"componentName\":\"x\"},{\"name\":\"sendMessage\",\"description\":\"Sends a message to the server.\",\"type\":\"action\",\"componentName\":\"gotify\"},{\"name\":\"sendMessage\",\"description\":\"Send a new message\",\"type\":\"action\",\"componentName\":\"intercom\"},{\"name\":\"sendMessage\",\"description\":\"Send a new RabbitMQ message.\",\"type\":\"action\",\"componentName\":\"rabbitMQ\"},{\"name\":\"sendMessage\",\"description\":\"Sends a message through a Telegram bot.\",\"type\":\"action\",\"componentName\":\"telegram\"},{\"name\":\"sendMessage\",\"description\":\"Send a message via WhatsApp\",\"type\":\"action\",\"componentName\":\"whatsApp\"},{\"name\":\"sendSpaceMessage\",\"description\":\"Sends a new message in selected space.\",\"type\":\"action\",\"componentName\":\"googleChat\"},{\"name\":\"sendWhatsAppMessage\",\"description\":\"Send a new WhatsApp message.\",\"type\":\"action\",\"componentName\":\"twilio\"},{\"name\":\"sendWhatsappTemplateMessage\",\"description\":\"Send a template message.\",\"type\":\"action\",\"componentName\":\"infobip\"},{\"name\":\"sendWhatsappTextMessage\",\"description\":\"Send a  WhatsApp text message to a single recipient.\",\"type\":\"action\",\"componentName\":\"infobip\"},{\"name\":\"sendDynamicTemplate\",\"description\":\"Send an email using a dynamic template.\",\"type\":\"action\",\"componentName\":\"sendgrid\"},{\"name\":\"sendEmail\",\"description\":\"Send an email\",\"type\":\"action\",\"componentName\":\"resend\"},{\"name\":\"sendEmail\",\"description\":\"Sends an email.\",\"type\":\"action\",\"componentName\":\"sendgrid\"},{\"name\":\"createSocialMediaMessage\",\"description\":\"Post a message to one of your social media channel.\",\"type\":\"action\",\"componentName\":\"vbout\"},{\"name\":\"sendEmail\",\"description\":\"Creates and sends a new email message from your Gmail account.\",\"type\":\"action\",\"componentName\":\"googleMail\"},{\"name\":\"sendEmail\",\"description\":\"Sends a new email message.\",\"type\":\"action\",\"componentName\":\"microsoftOutlook365\"},{\"name\":\"sendMedia\",\"description\":\"Sends a media message through a Telegram bot.\",\"type\":\"action\",\"componentName\":\"telegram\"},{\"name\":\"sendSMS\",\"description\":\"Send a new SMS message to one or more recipients.\",\"type\":\"action\",\"componentName\":\"infobip\"},{\"name\":\"sendSMS\",\"description\":\"Send a new SMS message\",\"type\":\"action\",\"componentName\":\"twilio\"}]","messageId":"6d021029-8d83-4391-b543-113c43a10256","rawEvent":null,"role":"tool","timestamp":1792280255693,"toolCallId":"37e042b1-0f6a-4922-b9ba-7dd123216f19","type":"TOOL_CALL_RESULT"}

