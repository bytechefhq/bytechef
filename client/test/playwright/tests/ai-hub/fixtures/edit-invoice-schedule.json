{
    "label": "Invoice Search",
    "description": "Finds invoice emails every morning",
    "inputs": [],
    "triggers": [
        {
            "label": "Every Morning",
            "name": "trigger_1",
            "type": "schedule/v1/everyDay",
            "parameters": {
                "dayOfWeek": [1, 2, 3, 4, 5, 6, 7],
                "hour": 8,
                "minute": 0,
                "timezone": "UTC"
            }
        }
    ],
    "tasks": [
        {
            "label": "Find Invoices",
            "name": "searchEmail_1",
            "type": "googleMail/v1/searchEmail",
            "parameters": {
                "query": "subject:invoice"
            }
        }
    ]
}
