<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="202604061200042-1" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="workspace_user" columnName="workspace_role"/>
            </not>
        </preConditions>

        <addColumn tableName="workspace_user">
            <column name="workspace_role" type="INT" valueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="202604061200042-2" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="workspace_user" columnName="custom_role_id"/>
            </not>
        </preConditions>

        <addColumn tableName="workspace_user">
            <column name="custom_role_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="202604061200042-3" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_constraint WHERE conname = 'chk_workspace_user_role_xor'
            </sqlCheck>
        </preConditions>

        <sql>
            ALTER TABLE workspace_user ADD CONSTRAINT chk_workspace_user_role_xor
            CHECK ((workspace_role IS NOT NULL AND custom_role_id IS NULL) OR
                   (workspace_role IS NULL AND custom_role_id IS NOT NULL));
        </sql>
    </changeSet>

    <changeSet id="202604061200042-4" author="Ivica Cardic">
        <sql>
            SELECT setval(
                pg_get_serial_sequence('workspace_user', 'id'),
                GREATEST((SELECT COALESCE(MAX(id), 0) FROM workspace_user), 1));
        </sql>
    </changeSet>
</databaseChangeLog>
