FROM ghcr.io/graalvm/jdk-community:25i2-25.0.4 AS build

WORKDIR /build

COPY ./.git ./.git
COPY ./buildSrc ./buildSrc
COPY ./gradle ./gradle
COPY ./gradlew ./gradlew
COPY ./spring-ai ./spring-ai
COPY ./cli ./cli
COPY ./sdks ./sdks
COPY ./server ./server
COPY ./build.gradle.kts ./build.gradle.kts
COPY ./gradle.properties ./gradle.properties
COPY ./settings.gradle.kts ./settings.gradle.kts

RUN --mount=type=cache,target=/root/.gradle/caches \
    --mount=type=cache,target=/root/.gradle/wrapper \
    ./gradlew bootJar --no-daemon

FROM ghcr.io/graalvm/jdk-community:25i2-25.0.4

WORKDIR /opt

ENV JAVA_TOOL_OPTIONS="--enable-native-access=ALL-UNNAMED"

COPY --from=build /build/server/apps/server-app/build/libs/server-app*.jar server-app.jar

EXPOSE 9555

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar server-app.jar"]
