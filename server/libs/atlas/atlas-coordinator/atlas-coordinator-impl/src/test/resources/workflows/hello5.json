{
  "label": "First Task Disabled Demo",
  "outputs": [ {
    "name": "skippedValue",
    "value": "${firstNumber}"
  } ],
  "tasks": [ {
    "name": "firstNumber",
    "type": "randomHelper/v1/randomInt",
    "disabled": true,
    "parameters": {
      "startInclusive": 1,
      "endInclusive": 2
    }
  }, {
    "name": "secondNumber",
    "type": "randomHelper/v1/randomInt",
    "parameters": {
      "startInclusive": "${firstNumber}",
      "endInclusive": 2
    }
  }, {
    "name": "thirdNumber",
    "type": "randomHelper/v1/randomInt",
    "parameters": {
      "startInclusive": 1,
      "endInclusive": 2
    }
  } ]
}