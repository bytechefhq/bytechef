<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        The empty <rollback/> blocks in this file are deliberate, not omissions.

        A changeset guarded by a MARK_RAN precondition can be recorded as ran without having applied its change, so
        its inverse must never run. With no rollback declared Liquibase auto-generates that inverse (dropColumn,
        dropTable, and so on) and a rollback would then destroy an object this changeset never created. An empty
        rollback leaves the object in place instead: inert, and re-applying the changeset is a no-op through the same
        precondition.
    -->

    <changeSet id="20260611120100" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="principal_job_job_id_type_index"/>
            </not>
        </preConditions>

        <createIndex indexName="principal_job_job_id_type_index" tableName="principal_job">
            <column name="job_id"/>
            <column name="type"/>
        </createIndex>
        <rollback/>
    </changeSet>

    <changeSet id="20260611120101" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_principal_job_principal_id_type"/>
            </not>
        </preConditions>

        <createIndex indexName="idx_principal_job_principal_id_type" tableName="principal_job">
            <column name="principal_id"/>
            <column name="type"/>
        </createIndex>
        <rollback/>
    </changeSet>
</databaseChangeLog>
