<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        The empty <rollback/> blocks in this file are deliberate, not omissions.

        A changeset guarded by a MARK_RAN precondition can be recorded as ran without having applied its change, so
        its inverse must never run. With no rollback declared Liquibase auto-generates that inverse (dropColumn,
        dropTable, and so on) and a rollback would then destroy an object this changeset never created. An empty
        rollback leaves the object in place instead: inert, and re-applying the changeset is a no-op through the same
        precondition.
    -->

    <changeSet id="20251214090700-1" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="data_entry" columnName="environment"/>
            </not>
        </preConditions>

        <addColumn tableName="data_entry">
            <column name="environment" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback/>
    </changeSet>

    <changeSet id="20251214090700-2" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <and>
                <uniqueConstraintExists tableName="data_entry" constraintName="uk_data_entry_key"/>
                <columnExists tableName="data_entry" columnName="environment"/>
            </and>
        </preConditions>

        <dropUniqueConstraint tableName="data_entry" constraintName="uk_data_entry_key"/>

        <addUniqueConstraint
            constraintName="uk_data_entry_key"
            tableName="data_entry"
            columnNames="scope, scope_id, key, environment"/>
        <rollback/>
    </changeSet>

</databaseChangeLog>
