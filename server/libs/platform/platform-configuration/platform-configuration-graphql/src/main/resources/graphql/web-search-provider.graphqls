extend type Query {
    webSearchProviders(environment: ID!): [WebSearchProvider!]!
}

extend type Mutation {
    deleteWebSearchProvider(environment: ID!, name: String!): Boolean
    enableWebSearchProvider(enabled: Boolean!, environment: ID!, name: String!): Boolean
    testWebSearchProvider(apiKey: String, baseUrl: String, environment: ID!, name: String!): WebSearchProviderTestResult!
    updateWebSearchProvider(apiKey: String, baseUrl: String, environment: ID!, name: String!): Boolean
}

type WebSearchProvider {
    apiKeyFromProperties: Boolean!
    baseUrl: String!
    defaultBaseUrl: String!
    description: String!
    enabled: Boolean!
    icon: String
    label: String!
    maskedApiKey: String
    name: String!
}

type WebSearchProviderTestResult {
    errorMessage: String
    success: Boolean!
}
