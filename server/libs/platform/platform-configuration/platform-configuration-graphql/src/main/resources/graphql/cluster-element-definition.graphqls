extend type Query {
    clusterElementDefinition(componentName: String!, componentVersion: Int!, clusterElementName: String!, clusterElementType: String): ClusterElementDefinition!
    clusterElementDefinitions(rootComponentName: String!, rootComponentVersion: Int!, clusterElementType: String!): [ClusterElementDefinition!]!
    clusterElementDynamicProperties(
        componentName: String!
        componentVersion: Int!
        clusterElementName: String!
        propertyName: String!
        connectionId: Long
        inputParameters: Map
        lookupDependsOnPaths: [String!]
    ): [Property!]!
    clusterElementOptions(
        componentName: String!
        componentVersion: Int!
        clusterElementName: String!
        propertyName: String!
        connectionId: Long
        inputParameters: Map
        lookupDependsOnPaths: [String!]
    ): [Option!]!
    """Workflow-less variant of FieldsProvider.getFields() — used by the Add Context Source wizard to
    populate ID Field and Indexed Fields name dropdowns. Returns an empty list when the cluster element
    does not implement FieldsProvider (the wizard then falls back to free-text input)."""
    clusterElementFields(
        componentName: String!
        componentVersion: Int!
        clusterElementName: String!
        connectionId: Long
        inputParameters: Map
    ): [Field!]!
}

type Field {
    name: String!
    label: String
    """Java class simple name of the field's type, e.g. String, Long, Instant. Used by the wizard to
    auto-prefill the indexed-field-type selector (String → TEXT, Long/Integer/Double/Float → NUMERIC,
    Instant/LocalDateTime/LocalDate → TIMESTAMP, anything else → TEXT). User can override."""
    type: String
}

type ClusterElementDefinition {
    componentName: String
    componentVersion: Int
    description: String
    help: Help
    icon: String
    name: String!
    outputDefined: Boolean!
    outputFunctionDefined: Boolean!
    outputSchemaDefined: Boolean
    properties: [Property!]!
    title: String
    type: ClusterElementType
}

type ClusterElementType {
    key: String
    label: String
    multipleElements: Boolean
    name: String
    required: Boolean
}
