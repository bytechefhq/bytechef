<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260825000001" author="Ivica Cardic" dbms="postgresql" runInTransaction="false">
        <sql>
            CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS uk_property_key_scope_environment_null_scope_id
                ON property (key, scope, environment)
                WHERE scope_id IS NULL;
        </sql>

        <rollback>
            DROP INDEX CONCURRENTLY IF EXISTS uk_property_key_scope_environment_null_scope_id;
        </rollback>
    </changeSet>

</databaseChangeLog>
