extend type Query {
    mcpTool(id: ID): McpTool
    mcpTools: [McpTool]
    mcpToolsByComponentId(mcpComponentId: ID): [McpTool]
}

extend type Mutation {
    createMcpTool(input: McpToolInput!): McpTool
    deleteMcpTool(id: ID!): Boolean
    updateMcpTool(id: ID!, input: McpToolInput!): McpTool
    updateMcpToolEnabled(id: ID!, enabled: Boolean!): McpTool
}

input McpToolInput {
    mcpComponentId: ID!
    name: String!
    parameters: Map
    version: Int
}

type McpTool {
    id: ID!
    name: String!
    title: String
    parameters: Map
    enabled: Boolean!
    mcpComponentId: ID!
    createdBy: String
    createdDate: Long
    lastModifiedBy: String
    lastModifiedDate: Long
    version: Int
}
