extend type Query {
    mcpServer(id: ID): McpServer
}

extend type Mutation {
    updateMcpServer(id: ID!, input: McpServerUpdateInput!): McpServer
    updateMcpServerUrl(id: ID!): String!
    updateMcpServerTags(id: ID!, tags: [TagInput!]!): [Tag]
    deleteMcpServer(id: ID!): Boolean
}

type McpServer {
    id: ID!
    name: String!
    type: PlatformType!
    environmentId: ID!
    enabled: Boolean!
    enforceToolAuthorization: Boolean!
    authenticationRequired: Boolean!
    mcpComponents: [McpComponent]
    url: String!
    secretKey: String
    tags: [Tag]
    createdBy: String
    createdDate: Long
    lastModifiedBy: String
    lastModifiedDate: Long
    version: Int
}

input McpServerUpdateInput {
    name: String
    enabled: Boolean
    enforceToolAuthorization: Boolean
    authenticationRequired: Boolean
}
