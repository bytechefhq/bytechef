<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20260707000001-1" author="Ivica Cardic">
        <addColumn tableName="mcp_server">
            <column name="enforce_tool_authorization" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260707000001-2" author="Ivica Cardic">
        <createTable tableName="mcp_component_authority">
            <column name="mcp_component_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="authority" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="mcp_component_authority" columnNames="mcp_component_id,authority"/>

        <addForeignKeyConstraint
            baseTableName="mcp_component_authority"
            baseColumnNames="mcp_component_id"
            constraintName="fk_mcp_component_authority_mcp_component"
            referencedTableName="mcp_component"
            referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
