<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20261010000001-1" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="mcp_server" columnName="uuid"/>
            </not>
        </preConditions>
        <addColumn tableName="mcp_server">
            <column name="uuid" type="${uuid_type}"/>
        </addColumn>
        <rollback/>
    </changeSet>

    <changeSet id="20261010000001-2" author="Ivica Cardic" dbms="postgresql">
        <sql>
            UPDATE mcp_server
            SET uuid = gen_random_uuid()
            WHERE uuid IS NULL;
        </sql>
    </changeSet>

    <changeSet id="20261010000001-3" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists tableName="mcp_server" constraintName="uk_mcp_server_uuid_environment"/>
            </not>
        </preConditions>
        <addNotNullConstraint tableName="mcp_server" columnName="uuid"/>
        <addUniqueConstraint constraintName="uk_mcp_server_uuid_environment" tableName="mcp_server" columnNames="uuid,environment"/>
        <rollback/>
    </changeSet>
</databaseChangeLog>
