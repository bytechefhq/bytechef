<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260806000001" author="Ivica Cardic">
        <createTable tableName="ai_skill_tag">
            <column name="ai_skill_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="ai_skill_tag" columnNames="ai_skill_id,tag_id"/>

        <addForeignKeyConstraint
            baseTableName="ai_skill_tag"
            baseColumnNames="ai_skill_id"
            constraintName="fk_ai_skill_tag_ai_skill"
            referencedTableName="ai_skill"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="ai_skill_tag"
            baseColumnNames="tag_id"
            constraintName="fk_ai_skill_tag_tag"
            referencedTableName="tag"
            referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
