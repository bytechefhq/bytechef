extend type Query {
    aiSkills: [AiSkill!]!
    aiSkill(id: ID!): AiSkill!
    aiSkillFilePaths(id: ID!): [String!]!
    aiSkillFileContent(id: ID!, path: String!): String!
    aiSkillTags: [Tag!]!
}

extend type Mutation {
    createAiSkill(name: String!, description: String, filename: String!, "Base64-encoded bytes of the skill archive" fileBytes: String!): AiSkill!
    createAiSkillFromInstructions(name: String!, description: String, "Markdown instructions for the skill" instructions: String!): AiSkill!
    "Generate a complete skill from a single natural-language prompt using the autonomous skills agent."
    generateAiSkill("Natural-language description of the skill to build" prompt: String!, "Environment (ordinal) to resolve the AI provider for" environmentId: Int!): AiSkill!
    updateAiSkill(id: ID!, name: String!, description: String): AiSkill!
    updateAiSkillContent(id: ID!, path: String, content: String!): AiSkill!
    createAdditionalFilesInSkill(id: ID!, additionalFiles: Map!): AiSkill!
    removeFileInSkill(id: ID!, path: String!): AiSkill!
    deleteAiSkill(id: ID!): Boolean!
    updateAiSkillTags(id: ID!, tags: [AiSkillTagInput!]): AiSkill!
}

input AiSkillTagInput {
    id: ID
    name: String!
}

type AiSkill {
    id: ID!
    name: String!
    description: String
    tags: [Tag!]!
    "Epoch milliseconds (UTC)"
    createdDate: Long
    "Epoch milliseconds (UTC)"
    lastModifiedDate: Long
}
