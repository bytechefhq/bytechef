<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!-- Every memory is created for a workspace, and a NULL would also slip past uk_ai_auto_memory_owner_env_name. -->
    <changeSet id="20261002000001" author="Ivica Cardic">
        <addNotNullConstraint tableName="ai_auto_memory" columnName="workspace_id" columnDataType="BIGINT"/>
    </changeSet>
</databaseChangeLog>
