scalar Long
scalar Map

type Query

type Mutation

type Tag {
    id: ID!
    name: String!
}

input TagInput {
    id: ID
    name: String!
}

input WorkflowConfigurationInput {
    workflowId: String!
    connections: [WorkflowConnectionInput!]
    inputs: Map
}

input WorkflowConnectionInput {
    connectionId: ID!
    workflowConnectionKey: String!
    workflowNodeName: String!
}
