<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20261017000000-1" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="a2a_server" columnName="workspace_id"/>
            </not>
        </preConditions>

        <addColumn tableName="a2a_server">
            <column name="workspace_id" type="BIGINT"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="a2a_server" columnName="workspace_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20261017000000-2" author="Ivica Cardic">
        <update tableName="a2a_server">
            <column name="workspace_id" valueNumeric="1049"/>
            <where>workspace_id IS NULL</where>
        </update>
        <rollback/>
    </changeSet>
</databaseChangeLog>
