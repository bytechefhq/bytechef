<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20260908000001-1" author="Ivica Cardic">
        <dropForeignKeyConstraint baseTableName="workspace_mcp_server"
                                  constraintName="fk_workspace_mcp_server_mcp_server"/>

        <addForeignKeyConstraint
            baseTableName="workspace_mcp_server"
            baseColumnNames="mcp_server_id"
            constraintName="fk_workspace_mcp_server_mcp_server"
            referencedTableName="mcp_server"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
