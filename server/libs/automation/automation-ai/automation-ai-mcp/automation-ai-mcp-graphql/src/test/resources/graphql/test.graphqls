# Test-only GraphQL schema for automation-mcp GraphQL slice tests.
# Contains the root types and the types the production schema references from other modules.

# Custom scalars
scalar Any
scalar Long
scalar Map

# Enums
enum PlatformType {
    AUTOMATION
    EMBEDDED
}

# Root types extended by the production schema files in src/main/resources/graphql
type Query

type Mutation

# Main types
type McpServer {
    id: ID!
    name: String
    type: PlatformType
    enabled: Boolean
    secretKey: String
    createdBy: String
    createdDate: Long
    lastModifiedBy: String
    lastModifiedDate: Long
    version: Int
}

type McpTool {
    id: ID!
    name: String!
    parameters: Map
    enabled: Boolean!
    mcpComponentId: ID!
}

# Referenced type stubs
type Tag {
    id: ID
    name: String
}

type Project {
    id: ID
    name: String
}

type ProjectDeploymentWorkflow {
    id: ID
    workflowId: String
}

type ProjectWorkflow {
    id: ID!
    projectId: ID!
    workflowId: String!
    projectVersion: Int!
    uuid: String
    sseStreamResponse: Boolean!
    workflow: Workflow!
    createdBy: String
    createdDate: String
    lastModifiedBy: String
    lastModifiedDate: String
    version: Int!
}

type Workflow {
    id: ID
    label: String
    triggers: [WorkflowTrigger!]!
}

type WorkflowTrigger {
    name: String!
    label: String
    type: String!
    parameters: Map
    description: String
}

enum PropertyType {
    ARRAY
    BOOLEAN
    DATE
    DATE_TIME
    DYNAMIC_PROPERTIES
    FILE_ENTRY
    INTEGER
    NULL
    NUMBER
    OBJECT
    STRING
    TIME
}

interface Property {
    advancedOption: Boolean
    description: String
    displayCondition: String
    expressionEnabled: Boolean
    hidden: Boolean
    name: String
    required: Boolean
    type: PropertyType!
}

type StringProperty implements Property {
    advancedOption: Boolean
    description: String
    displayCondition: String
    expressionEnabled: Boolean
    hidden: Boolean
    name: String
    required: Boolean
    type: PropertyType!
    controlType: String
    label: String
    placeholder: String
}

type IntegerProperty implements Property {
    advancedOption: Boolean
    description: String
    displayCondition: String
    expressionEnabled: Boolean
    hidden: Boolean
    name: String
    required: Boolean
    type: PropertyType!
    controlType: String
    label: String
    placeholder: String
}

type NumberProperty implements Property {
    advancedOption: Boolean
    description: String
    displayCondition: String
    expressionEnabled: Boolean
    hidden: Boolean
    name: String
    required: Boolean
    type: PropertyType!
    controlType: String
    label: String
    placeholder: String
}

type BooleanProperty implements Property {
    advancedOption: Boolean
    description: String
    displayCondition: String
    expressionEnabled: Boolean
    hidden: Boolean
    name: String
    required: Boolean
    type: PropertyType!
    controlType: String
    label: String
    placeholder: String
}

type ObjectProperty implements Property {
    advancedOption: Boolean
    description: String
    displayCondition: String
    expressionEnabled: Boolean
    hidden: Boolean
    name: String
    required: Boolean
    type: PropertyType!
    controlType: String
    label: String
    placeholder: String
}

type ArrayProperty implements Property {
    advancedOption: Boolean
    description: String
    displayCondition: String
    expressionEnabled: Boolean
    hidden: Boolean
    name: String
    required: Boolean
    type: PropertyType!
    controlType: String
    label: String
    placeholder: String
}
