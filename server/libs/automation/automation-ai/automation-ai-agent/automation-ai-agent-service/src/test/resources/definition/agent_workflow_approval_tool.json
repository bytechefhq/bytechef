{
  "label": "News Agent",
  "description": "Auto-generated by Agents. Edits via the Agent Studio UI.",
  "inputs": [ ],
  "triggers": [ {
    "name": "chat_1",
    "type": "chat/v1/newChatRequest",
    "parameters": {
      "mode": 1
    }
  }, {
    "name": "workflowCall_1",
    "type": "workflow/v1/newWorkflowCall",
    "parameters": {
      "inputSchema": "{\"type\":\"object\",\"properties\":{\"conversationId\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"attachments\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}}},\"required\":[\"conversationId\",\"message\"]}"
    }
  }, {
    "name": "telegram_1",
    "type": "telegram/v1/newMessage",
    "parameters": { },
    "connections": {
      "telegram": {
        "componentName": "telegram",
        "componentVersion": 1
      }
    }
  }, {
    "name": "schedule_1",
    "type": "schedule/v1/cron",
    "parameters": {
      "timezone": "UTC",
      "expression": "0 9 * * *"
    }
  } ],
  "tasks": [ {
    "name": "branch_in",
    "type": "branch/v1",
    "parameters": {
      "expression": "${__triggerName}",
      "cases": [ {
        "key": "chat_1",
        "tasks": [ {
          "name": "envelope_chat_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "${chat_1.message}",
              "conversationId": "${chat_1.conversationId}",
              "attachments": "${chat_1.attachments}",
              "channel": "chat"
            }
          }
        } ]
      }, {
        "key": "workflowCall_1",
        "tasks": [ {
          "name": "envelope_workflowCall_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "${workflowCall_1.message}",
              "conversationId": "${workflowCall_1.conversationId}",
              "attachments": "${workflowCall_1.attachments}",
              "channel": "workflowCall"
            }
          }
        } ]
      }, {
        "key": "telegram_1",
        "tasks": [ {
          "name": "envelope_telegram_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "${telegram_1.message.text}",
              "conversationId": "${telegram_1.message.chat.id}",
              "attachments": [ ],
              "channel": "telegram"
            }
          }
        } ]
      }, {
        "key": "schedule_1",
        "tasks": [ {
          "name": "envelope_schedule_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "Summarize today's news",
              "conversationId": "90dcefad-c7a5-3c43-ba3d-6a0e4f28f386",
              "attachments": [ ],
              "channel": "schedule"
            }
          }
        } ]
      } ]
    }
  }, {
    "name": "aiAgent_1",
    "type": "aiAgent/v1/streamChat",
    "parameters": {
      "format": "SIMPLE",
      "userPrompt": "${branch_in.text}",
      "attachments": "${branch_in.attachments}"
    },
    "clusterElements": {
      "tools": [ {
        "name": "aiAgentUtils_1",
        "type": "aiAgentUtils/v1/askUserQuestionTool",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_2",
        "type": "aiAgentUtils/v1/autoMemoryTool",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_3",
        "type": "aiAgentUtils/v1/createAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_4",
        "type": "aiAgentUtils/v1/updateAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_5",
        "type": "aiAgentUtils/v1/deleteAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_6",
        "type": "aiAgentUtils/v1/appendFilesToAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_7",
        "type": "aiAgentUtils/v1/removeFileFromAiSkill",
        "parameters": { }
      }, {
        "name": "approval_1",
        "type": "approval/v1/requestApproval",
        "parameters": { },
        "clusterElements": {
          "approvalChannels": [ {
            "name": "chat_1",
            "type": "chat/v1/chat",
            "parameters": { }
          }, {
            "name": "telegram_1",
            "type": "telegram/v1/telegram",
            "parameters": { },
            "connections": {
              "telegram_1": {
                "componentName": "telegram",
                "componentVersion": 1
              }
            }
          } ]
        }
      } ]
    },
    "aiHubAgentId": 1
  }, {
    "name": "branch_out",
    "type": "branch/v1",
    "parameters": {
      "expression": "${__triggerName}",
      "cases": [ {
        "key": "chat_1",
        "tasks": [ {
          "name": "reply_chat_1",
          "type": "chat/v1/responseToRequest",
          "parameters": {
            "message": "${aiAgent_1}"
          }
        } ]
      }, {
        "key": "workflowCall_1",
        "tasks": [ {
          "name": "reply_workflowCall_1",
          "type": "workflow/v1/responseToWorkflowCall",
          "parameters": {
            "response": {
              "message": "${aiAgent_1}"
            },
            "outputSchema": "{\"type\":\"object\",\"properties\":{\"message\":{\"type\":\"string\"}},\"required\":[\"message\"]}"
          }
        } ]
      }, {
        "key": "telegram_1",
        "tasks": [ {
          "name": "reply_telegram_1",
          "type": "telegram/v1/sendMessage",
          "parameters": {
            "text": "${aiAgent_1}",
            "chat_id": "${branch_in.conversationId}"
          },
          "connections": {
            "telegram": {
              "componentName": "telegram",
              "componentVersion": 1
            }
          }
        } ]
      }, {
        "key": "schedule_1",
        "tasks": [ ]
      } ]
    }
  } ]
}