{
  "label": "News Agent",
  "description": "Auto-generated by Agents. Edits via the Agent Studio UI.",
  "inputs": [ ],
  "triggers": [ {
    "name": "chat_1",
    "type": "chat/v1/newChatRequest",
    "parameters": {
      "mode": 1
    }
  }, {
    "name": "workflowCall_1",
    "type": "workflow/v1/newWorkflowCall",
    "parameters": {
      "inputSchema": "{\"type\":\"object\",\"properties\":{\"message\":{\"type\":\"string\"},\"conversationId\":{\"type\":\"string\"},\"attachments\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}}},\"required\":[\"message\"]}"
    }
  }, {
    "name": "telegram_1",
    "type": "telegram/v1/newMessage",
    "parameters": { },
    "connections": {
      "telegram": {
        "componentName": "telegram",
        "componentVersion": 1
      }
    }
  }, {
    "name": "schedule_1",
    "type": "schedule/v1/cron",
    "parameters": {
      "timezone": "UTC",
      "expression": "0 9 * * *"
    }
  } ],
  "tasks": [ {
    "name": "branch_in",
    "type": "branch/v1",
    "parameters": {
      "expression": "${__triggerName}",
      "cases": [ {
        "key": "chat_1",
        "tasks": [ {
          "name": "envelope_chat_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "${chat_1.message}",
              "conversationId": "${chat_1.conversationId}",
              "attachments": "${chat_1.attachments}",
              "replyTo": null,
              "channel": "chat"
            }
          }
        } ]
      }, {
        "key": "workflowCall_1",
        "tasks": [ {
          "name": "envelope_workflowCall_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "${workflowCall_1.message}",
              "conversationId": "${workflowCall_1.conversationId}",
              "attachments": "${workflowCall_1.attachments}",
              "replyTo": null,
              "channel": "workflowCall"
            }
          }
        } ]
      }, {
        "key": "telegram_1",
        "tasks": [ {
          "name": "envelope_telegram_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "${telegram_1.message.text}",
              "conversationId": "${telegram_1.message.chat.id}",
              "attachments": [ ],
              "replyTo": "${telegram_1.message.chat.id}",
              "channel": "telegram"
            }
          }
        } ]
      }, {
        "key": "schedule_1",
        "tasks": [ {
          "name": "envelope_schedule_1",
          "type": "var/v1/set",
          "parameters": {
            "value": {
              "text": "Summarize today's news",
              "conversationId": "90dcefad-c7a5-3c43-ba3d-6a0e4f28f386",
              "attachments": [ ],
              "replyTo": null,
              "channel": "schedule"
            }
          }
        } ]
      } ]
    }
  }, {
    "name": "aiAgent_1",
    "type": "aiAgent/v1/streamChat",
    "parameters": {
      "format": "SIMPLE",
      "userPrompt": "${branch_in.text}",
      "attachments": "${branch_in.attachments}"
    },
    "clusterElements": {
      "model": {
        "name": "openAi_1",
        "type": "openAi/v1/model",
        "parameters": {
          "model": "gpt-5-nano"
        },
        "connections": {
          "openAi_1": {
            "componentName": "openAi",
            "componentVersion": 1
          }
        }
      },
      "tools": [ {
        "name": "slack_1",
        "type": "slack/v1/sendMessage",
        "parameters": {
          "channel": "#general"
        },
        "connections": {
          "slack_1": {
            "componentName": "slack",
            "componentVersion": 1
          }
        }
      }, {
        "name": "aiAgentUtils_1",
        "type": "aiAgentUtils/v1/approvalGateTool",
        "parameters": {
          "name": "Requires approval",
          "approvalExpiresIn": 4,
          "approvalExpiresInUnit": "HOURS"
        },
        "clusterElements": {
          "tools": [ {
            "name": "stripe_1",
            "type": "stripe/v1/createRefund",
            "parameters": {
              "amount": 100
            },
            "connections": {
              "stripe_1": {
                "componentName": "stripe",
                "componentVersion": 1
              }
            }
          } ],
          "approvalChannels": [ {
            "name": "chat_1",
            "type": "chat/v1/chat",
            "parameters": { }
          }, {
            "name": "telegram_1",
            "type": "telegram/v1/telegram",
            "parameters": { },
            "connections": {
              "telegram_1": {
                "componentName": "telegram",
                "componentVersion": 1
              }
            }
          } ]
        }
      }, {
        "name": "aiAgentUtils_2",
        "type": "aiAgentUtils/v1/skillsTool",
        "parameters": {
          "skills": [ 10, 20 ]
        }
      }, {
        "name": "workflow_1",
        "type": "workflow/v1/callAiAgent",
        "parameters": {
          "toolName": "Support_Agent",
          "toolDescription": "Handles support questions.",
          "agentUuid": "22222222-2222-2222-2222-222222222222",
          "message": "=fromAi('message', 'The message to send to the sub-agent.')",
          "conversationId": "${branch_in.conversationId}"
        }
      }, {
        "name": "aiAgentUtils_3",
        "type": "aiAgentUtils/v1/askUserQuestionTool",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_4",
        "type": "aiAgentUtils/v1/autoMemoryTool",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_5",
        "type": "aiAgentUtils/v1/createAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_6",
        "type": "aiAgentUtils/v1/updateAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_7",
        "type": "aiAgentUtils/v1/deleteAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_8",
        "type": "aiAgentUtils/v1/appendFilesToAiSkill",
        "parameters": { }
      }, {
        "name": "aiAgentUtils_9",
        "type": "aiAgentUtils/v1/removeFileFromAiSkill",
        "parameters": { }
      }, {
        "name": "brave_1",
        "type": "brave/v1/webSearch",
        "parameters": { },
        "connections": {
          "brave_1": {
            "componentName": "brave",
            "componentVersion": 1
          }
        }
      }, {
        "name": "approval_1",
        "type": "approval/v1/requestApproval",
        "parameters": { },
        "clusterElements": {
          "approvalChannels": [ {
            "name": "chat_2",
            "type": "chat/v1/chat",
            "parameters": { }
          }, {
            "name": "telegram_2",
            "type": "telegram/v1/telegram",
            "parameters": { },
            "connections": {
              "telegram_2": {
                "componentName": "telegram",
                "componentVersion": 1
              }
            }
          } ]
        }
      } ],
      "rag": [ {
        "name": "questionAnswerRag_1",
        "type": "questionAnswerRag/v1/rag",
        "parameters": {
          "topK": 4,
          "similarityThreshold": 0.5
        },
        "clusterElements": {
          "vectorStore": {
            "name": "knowledgeBase_1",
            "type": "knowledgeBase/v1/vectorStore",
            "parameters": {
              "knowledgeBaseId": 7
            }
          }
        }
      } ],
      "chatMemory": {
        "name": "chatMemory_1",
        "type": "chatMemory/v1/chatMemory",
        "parameters": {
          "conversationId": "${branch_in.conversationId}"
        }
      }
    }
  }, {
    "name": "branch_out",
    "type": "branch/v1",
    "parameters": {
      "expression": "${branch_in.channel}",
      "cases": [ {
        "key": "chat",
        "tasks": [ {
          "name": "reply_chat",
          "type": "chat/v1/responseToRequest",
          "parameters": {
            "message": "${aiAgent_1}"
          }
        } ]
      }, {
        "key": "workflowCall",
        "tasks": [ {
          "name": "reply_workflowCall",
          "type": "workflow/v1/responseToWorkflowCall",
          "parameters": {
            "outputSchema": "{\"type\":\"object\",\"properties\":{\"message\":{\"type\":\"string\"}},\"required\":[\"message\"]}",
            "response": {
              "message": "${aiAgent_1}"
            }
          }
        } ]
      }, {
        "key": "telegram",
        "tasks": [ {
          "name": "reply_telegram",
          "type": "telegram/v1/sendMessage",
          "parameters": {
            "chat_id": "${branch_in.replyTo}",
            "text": "${aiAgent_1}"
          },
          "connections": {
            "telegram": {
              "componentName": "telegram",
              "componentVersion": 1
            }
          }
        } ]
      }, {
        "key": "schedule",
        "tasks": [ ]
      } ]
    }
  } ]
}