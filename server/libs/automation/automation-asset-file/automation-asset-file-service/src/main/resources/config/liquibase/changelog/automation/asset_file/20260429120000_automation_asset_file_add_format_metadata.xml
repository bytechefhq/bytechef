<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20260429120000-1" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="asset_file" columnName="format"/>
            </not>
        </preConditions>

        <addColumn tableName="asset_file">
            <column name="format" type="SMALLINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260429120000-2" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="asset_file" columnName="metadata_json"/>
            </not>
        </preConditions>

        <addColumn tableName="asset_file">
            <column name="metadata_json" type="TEXT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
