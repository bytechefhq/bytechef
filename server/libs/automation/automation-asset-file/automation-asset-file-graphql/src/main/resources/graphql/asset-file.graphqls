type AssetFile {
    id: ID!
    name: String!
    description: String
    mimeType: String!
    sizeBytes: Long!
    source: AssetFileSource!
    generatedByAgentSource: Int
    generatedFromPrompt: String
    format: String
    metadataJson: String
    environmentId: Long!
    tags: [Tag!]!
    createdBy: String
    createdDate: Long
    lastModifiedBy: String
    lastModifiedDate: Long
    downloadUrl: String!
    publicLinkUrl: String
}

type AssetFileVersion {
    id: ID!
    versionNumber: Int!
    mimeType: String!
    sizeBytes: Long!
    createdBy: String
    createdDate: Long
}

enum AssetFileSource {
    USER_UPLOAD
    AI_GENERATED
}

extend type Query {
    assetFile(id: ID!): AssetFile
    assetFiles(workspaceId: ID!, environment: Int, tagIds: [ID!], mimeTypePrefix: String): [AssetFile!]!
    assetFileTags(workspaceId: ID!): [Tag!]!
    assetFileTextContent(id: ID!): String
    assetFileVersions(id: ID!): [AssetFileVersion!]!
    assetFileSignedDownloadUrl(id: ID!): String!
}

extend type Mutation {
    updateAssetFile(input: UpdateAssetFileInput!): AssetFile!
    updateAssetFileTextContent(id: ID!, content: String!): AssetFile!
    deleteAssetFile(id: ID!): Boolean!
    updateAssetFileTags(input: UpdateAssetFileTagsInput!): AssetFile!
    restoreAssetFileVersion(id: ID!, versionId: ID!): AssetFile!
    enableAssetFilePublicLink(id: ID!): AssetFile!
    disableAssetFilePublicLink(id: ID!): AssetFile!
}

input UpdateAssetFileInput {
    id: ID!
    name: String
    description: String
}

input UpdateAssetFileTagsInput {
    id: ID!
    tags: [TagInput!]!
}
