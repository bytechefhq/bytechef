<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        The empty <rollback/> blocks in this file are deliberate, not omissions.

        A changeset guarded by a MARK_RAN precondition can be recorded as ran without having applied its change, so
        its inverse must never run. With no rollback declared Liquibase auto-generates that inverse (dropColumn,
        dropTable, and so on) and a rollback would then destroy an object this changeset never created. An empty
        rollback leaves the object in place instead: inert, and re-applying the changeset is a no-op through the same
        precondition.
    -->

    <changeSet id="00000000000001" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workspace_connection"/>
            </not>
        </preConditions>

        <createTable tableName="workspace_connection">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="connection_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback/>
    </changeSet>

    <changeSet id="00000000000001-1" author="Ivica Cardic" contextFilter="mono">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workspace_connection"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
            baseTableName="workspace_connection"
            baseColumnNames="connection_id"
            constraintName="workspace_connection_connection"
            referencedTableName="connection"
            referencedColumnNames="id"/>
        <rollback/>
    </changeSet>
</databaseChangeLog>
