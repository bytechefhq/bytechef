<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20260818000001-1" author="Ivica Cardic">
        <addColumn tableName="project_deployment">
            <column name="uuid" type="${uuid_type}"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260818000001-2" author="Ivica Cardic" dbms="postgresql">
        <sql>
            UPDATE project_deployment
            SET uuid = gen_random_uuid()
            WHERE uuid IS NULL;
        </sql>
    </changeSet>

    <changeSet id="20260818000001-3" author="Ivica Cardic">
        <addNotNullConstraint tableName="project_deployment" columnName="uuid"/>
        <addUniqueConstraint constraintName="uk_project_deployment_uuid_environment" tableName="project_deployment" columnNames="uuid,environment"/>
    </changeSet>
</databaseChangeLog>
