extend type Query {
    eligibleErrorWorkflows(projectId: ID!, projectVersion: Int!): [ProjectWorkflow!]!
    preBuiltWorkflowTemplates(query: String, category: String): [WorkflowTemplate!]!
    projectWorkflow(id: ID!): ProjectWorkflow
    sharedWorkflow(workflowUuid: String!): SharedWorkflow
    workflowTemplate(id: String!, sharedWorkflow: Boolean!): WorkflowTemplate
    workspaceProjectWorkflows(workspaceId: ID!): [WorkspaceProjectWorkflow!]!
}

extend type Mutation {
    deleteSharedWorkflow(workflowId: String!): Boolean!
    exportSharedWorkflow(workflowId: String!, description: String): Boolean!
    importWorkflowTemplate(id: String!, projectId: ID!, sharedWorkflow: Boolean!): ID!
    updateProjectWorkflowErrorWorkflow(projectId: ID!, projectWorkflowId: ID!, errorProjectWorkflowId: ID, errorWorkflowDisabled: Boolean!): Boolean
}

type ProjectWorkflow {
    id: ID!
    projectId: ID!
    workflowId: String!
    projectVersion: Int!
    uuid: String
    sseStreamResponse: Boolean!
    workflow: Workflow!
    createdBy: String
    createdDate: String
    lastModifiedBy: String
    lastModifiedDate: String
    version: Int!
    errorProjectWorkflowId: ID
    errorWorkflowDisabled: Boolean!
}

"""
A flat, workspace-wide listing entry: one latest-version project workflow reduced to its label and ids.
Deliberately excludes the workflow definition — this powers pickers that list every workflow in a workspace,
where returning `ProjectWorkflow.workflow` per row would mean parsing every definition in the workspace.
"""
type WorkspaceProjectWorkflow {
    projectId: ID!
    projectName: String!
    projectWorkflowId: ID!
    workflowId: String!
    workflowLabel: String!
}

type SharedWorkflow {
    description: String
    exported: Boolean!
    projectVersion: Int
    publicUrl: String
}

type SharedWorkflowInfo {
    description: String
    label: String!
}

type WorkflowTemplate {
    authorEmail: String
    authorName: String
    authorRole: String
    authorSocialLinks: [String]!
    categories: [String!]!
    components: [ComponentDefinition!]!
    id: ID
    lastModifiedDate: String
    description: String
    projectVersion: Int
    publicUrl: String
    workflow: SharedWorkflowInfo!
}
