extend type Query {
    """Workspace connections whose component exposes at least one ItemReader cluster element."""
    dataStreamCompatibleConnections(workspaceId: ID!, environmentId: ID!): [DataStreamCompatibleConnection!]!
}

type DataStreamCompatibleConnection {
    id: ID!
    name: String!
    componentName: String!
    componentVersion: Int!
}

extend type Mutation {
    disconnectConnection(connectionId: ID!): Boolean!
    """Register an existing connection backed by an externally-provisioned credential (e.g. AWS Secrets Manager)."""
    registerExistingConnection(input: RegisterExistingConnectionInput!): Long!
}

input RegisterExistingConnectionInput {
    componentName: String!
    connectionVersion: Int!
    credentialRef: String!
    credentialStoreType: ConnectionCredentialStoreType!
    environmentId: ID!
    name: String!
    workspaceId: ID!
}
