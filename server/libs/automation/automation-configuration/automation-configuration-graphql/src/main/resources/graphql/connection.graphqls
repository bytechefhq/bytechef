extend type Query {
    """The workflows that use a connection, through a deployment or through the workflow editor."""
    connectionWorkflows(connectionId: ID!): [ConnectionWorkflow!]!
}

extend type Mutation {
    disconnectConnection(connectionId: ID!): Boolean!
    """Remove a connection from one workflow that uses it. The id is the one returned by connectionWorkflows."""
    disconnectConnectionFromWorkflow(connectionId: ID!, id: ID!, usage: ConnectionWorkflowUsage!): Boolean!
    """Replace an existing connection's authorization parameters. A parameter that is not submitted is cleared.
    Succeeding means the values were stored, not that they work."""
    updateConnectionCredentials(input: UpdateConnectionCredentialsInput!): Boolean!
    """Register an existing connection backed by an externally-provisioned credential (e.g. AWS Secrets Manager)."""
    registerExistingConnection(input: RegisterExistingConnectionInput!): Long!
}

input UpdateConnectionCredentialsInput {
    connectionId: ID!
    parameters: Map!
    version: Int!
}

type ConnectionWorkflow {
    id: ID!
    projectId: ID!
    projectName: String!
    projectVersion: Int!
    usage: ConnectionWorkflowUsage!
    workflowId: String!
    workflowName: String!
    workflowUuid: String
}

enum ConnectionWorkflowUsage {
    DEPLOYMENT
    EDITOR
}

input RegisterExistingConnectionInput {
    componentName: String!
    connectionVersion: Int!
    credentialRef: String!
    credentialStoreType: ConnectionCredentialStoreType!
    environmentId: ID!
    name: String!
    workspaceId: ID!
}
