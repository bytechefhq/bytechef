# Test-only GraphQL base operations and minimal type stubs for GraphQL slice tests in this module.

# Base operation types so that 'extend type Query/Mutation' from main resources can merge.
type Query {
    _placeholder: Boolean
}

type Mutation {
    _placeholder: Boolean
}

# Minimal type stubs referenced by this module's SDL

type ApiKey {
    id: ID
    name: String
}

type Category {
    id: ID
    name: String
}

type ComponentDefinition {
    name: String
}

type Environment {
    id: ID
    name: String
}

type Map {
    key: String
}

type Tag {
    id: ID
    name: String
    color: String
}

type Workflow {
    id: ID!
    description: String
    label: String!
}

type WorkspaceUser {
    id: ID!
    workspaceId: ID!
    userId: ID!
    workspaceRole: WorkspaceRole
    user: WorkspaceUserInfo
    createdDate: String
}

type WorkspaceUserInfo {
    email: String!
    firstName: String
    lastName: String
}

enum WorkspaceRole {
    ADMIN
    EDITOR
    VIEWER
}

type ProjectUser {
    id: ID!
    projectId: ID!
    userId: ID!
    projectRole: ProjectRole
    customRoleId: ID
    user: ProjectUserInfo
    createdDate: String
}

type ProjectUserInfo {
    email: String!
    firstName: String
    lastName: String
}

enum ProjectRole {
    ADMIN
    EDITOR
    OPERATOR
    VIEWER
}

enum WorkflowChangeType {
    ADDED
    REMOVED
    MODIFIED
    UNCHANGED
}

enum WorkflowNodeChangeKind {
    ADDED
    REMOVED
    MODIFIED
    MOVED
}

enum WorkflowNodeChangeTarget {
    WORKFLOW
    TRIGGER
    TASK
    CLUSTER_ELEMENT
    INPUT
    OUTPUT
}

type WorkflowDefinitionValueChange {
    path: String!
    oldValue: String
    newValue: String
}

type WorkflowDefinitionChange {
    kind: WorkflowNodeChangeKind!
    target: WorkflowNodeChangeTarget!
    name: String
    type: String
    label: String
    parentPath: String
    valueChanges: [WorkflowDefinitionValueChange!]!
}

type VersionWorkflowChangeSummary {
    workflowUuid: String!
    label: String
    changeType: WorkflowChangeType!
    changeCount: Int!
}

type VersionWorkflowChanges {
    baseVersion: Int
    version: Int!
    workflows: [VersionWorkflowChangeSummary!]!
}

type VersionWorkflowChange {
    workflowUuid: String!
    label: String
    changeType: WorkflowChangeType!
    baseVersion: Int
    version: Int!
    changes: [WorkflowDefinitionChange!]!
    oldDefinition: String
    newDefinition: String
}
