{
  "label": "CRM to DB",
  "description": "Auto-generated by Data Sync. Edits via the Data Sync UI.",
  "inputs": [ ],
  "metadata": {
    "dataSyncId": 42
  },
  "triggers": [ {
    "name": "trigger_1",
    "label": "Schedule",
    "type": "schedule/v1/cron",
    "parameters": {
      "expression": "0 9 * * ?",
      "timezone": "Europe/Zagreb"
    }
  } ],
  "tasks": [ {
    "name": "dataStream_1",
    "label": "CRM to DB",
    "type": "dataStream/v1/stream",
    "parameters": { },
    "clusterElements": {
      "source": {
        "name": "source_1",
        "label": "csvFile",
        "type": "csvFile/v1/read",
        "parameters": {
          "fileEntry": "${trigger_1.file}"
        },
        "connections": {
          "source_1": {
            "componentName": "csvFile",
            "componentVersion": 1
          }
        }
      },
      "destination": {
        "name": "destination_1",
        "label": "postgresql",
        "type": "postgresql/v1/insert",
        "parameters": {
          "mode": "FULL_REPLACE",
          "table": "contacts"
        },
        "connections": {
          "destination_1": {
            "componentName": "postgresql",
            "componentVersion": 1
          }
        }
      },
      "processor": {
        "name": "processor_1",
        "label": "dataStreamProcessor",
        "type": "dataStreamProcessor/v1/fieldMapper",
        "parameters": {
          "mappings": [ {
            "sourceField": "email",
            "destinationField": "email_address"
          } ]
        }
      }
    }
  } ]
}