<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="uuid_type" value="uuid" dbms="h2"/>
    <property name="uuid_type" value="uuid" dbms="postgresql"/>

    <!-- core -->
    <includeAll path="classpath:config/liquibase/changelog/core/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or connection or multitenant" />

    <!-- user -->
    <includeAll path="classpath:config/liquibase/changelog/platform/user/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or user or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/embedded/connected_user/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or user or multitenant" />

    <!-- connection -->
    <includeAll path="classpath:config/liquibase/changelog/platform/connection/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or connection or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/connection/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or connection or multitenant" />

    <!-- configuration -->
    <includeAll path="classpath:config/liquibase/changelog/atlas/configuration/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/configuration/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/mcp/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/notification/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/security/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/oauth2-authorization-server/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/code_workflow/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/custom_component/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!-- licence -->
    <includeAll path="classpath:config/liquibase/changelog/platform/licence" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/component_policy/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/resource_grant/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/configuration/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/mcp/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/a2a/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />

    <!--
        automation/workflow_execution_cost holds the per-job execution cost rows (base run charge + AI usage sum),
        written by the EE terminal-status listener in automation-workflow-execution-cost-service.
    -->
    <includeAll path="classpath:config/liquibase/changelog/automation/workflow_execution_cost" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        automation/workflow_alert holds the workspace-scoped alert rules (Sim alerts model) evaluated on terminal
        job events by the EE listener in automation-workflow-alert-service. Delivery targets reference
        notification(id), so this loads after platform/notification.
    -->
    <includeAll path="classpath:config/liquibase/changelog/automation/workflow_alert" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        platform/ai/llm/usage holds the shared ai_llm_usage table — single canonical LLM bookkeeping store for
        every agent surface. Loaded BEFORE automation/ai_gateway/ because the gateway's later
        ai_gateway_custom_property table has a request_log_id column referencing ai_llm_usage(id), and the
        gateway's init changeset previously included this table inline; the table creation was extracted here
        so the schema lives with its owning module while the gateway-specific routing tables stay in their
        place.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/llm/usage" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        platform/ai/prompt holds ai_prompt + ai_prompt_version — extracted from automation/ai_gateway so non-gateway
        agent surfaces can reuse the same prompt store. Loaded BEFORE automation/ai_gateway/ because the gateway's
        ai_observability_span FKs target these tables. The workspace_ai_prompt membership table lives in
        automation/ai/prompt (mirrors the workspace_ai_eval_* split between platform-ai-eval and automation-ai-eval).
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/prompt" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        platform/ai/observability holds ai_observability_session + ai_observability_trace + ai_observability_span +
        ai_observability_trace_tag + ai_observability_alert_rule (+ events + channels) + ai_observability_export_job +
        ai_observability_webhook_subscription (+ deliveries), plus the workspace_ai_observability_* relation tables.
        Extracted from automation/ai_gateway. Loaded BEFORE platform/ai/eval because ai_eval_score has FKs to
        ai_observability_trace + ai_observability_span; loaded BEFORE automation/ai_gateway/ because the gateway's
        later custom-property table FKs reference ai_llm_usage and span-eval rows reference these observability
        tables.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/observability" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        platform/ai/eval holds ai_eval_rule + ai_eval_score + ai_eval_score_config + ai_eval_execution. Loaded
        AFTER platform/ai/observability (because ai_eval_score FKs to ai_observability_trace + ai_observability_span)
        and BEFORE automation/ai_gateway/ (which has ai_observability_span FKs to ai_eval_score) AND BEFORE
        automation/ai/eval/ (which holds the workspace_ai_eval_* relation tables that FK to ai_eval_*).

        maxDepth="1" stops liquibase from recursing into platform/ai/eval/dataset and platform/ai/eval/experiment.
        Those subdirectories ship in their own modules and have explicit includeAll lines below; without the
        depth cap liquibase would load them via this path AND via their explicit lines, triggering
        "duplicate identifiers" validation at startup. Liquibase 4.30+ added minDepth/maxDepth on includeAll.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/eval" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" maxDepth="1" contextFilter="mono or configuration or multitenant" />
    <!--
        platform/ai/eval/dataset holds ai_eval_dataset + ai_eval_dataset_version + ai_eval_dataset_item — extracted
        from automation/ai_gateway. Loaded BEFORE automation/ai_gateway/ because the experiment changeset's
        ai_experiment.dataset_version_id and ai_experiment_run.dataset_item_id FKs reference these tables.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/eval/dataset" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        platform/ai/eval/experiment holds ai_eval_experiment + ai_eval_experiment_run — extracted from
        automation/ai_gateway. Loaded AFTER platform/ai/eval/dataset because the experiment FKs target
        ai_eval_dataset_version + ai_eval_dataset_item, and BEFORE automation/ai_gateway/ for symmetry with the rest
        of the platform/ai/eval/* split.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/eval/experiment" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        platform/ai/gateway holds the workspace-agnostic ai_gateway_* family (provider, model, budget,
        routing_policy, model_deployment, spend_summary, project, routing_policy_tag, rate_limit). Extracted from
        the original monolithic automation/ai_gateway init changeset so the platform tier owns the entity tables;
        the workspace_ai_gateway_* relation tables stay in automation/ai_gateway/. Loaded BEFORE automation/
        ai_gateway/ because the workspace_*-table FKs reference these entity tables.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/gateway" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/ai_gateway/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        automation/ai/eval holds workspace_ai_eval_rule + workspace_ai_eval_score + workspace_ai_eval_score_config —
        the relation tables that FK to ai_eval_* (in platform/ai/eval).
    -->
    <includeAll path="classpath:config/liquibase/changelog/automation/ai/eval" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" maxDepth="1" contextFilter="mono or configuration or multitenant" />
    <!--
        automation/ai/eval/dataset holds workspace_ai_eval_dataset — the membership table that FKs to ai_eval_dataset
        (in platform/ai/eval/dataset). Mirrors the workspace_ai_eval_rule split.
    -->
    <includeAll path="classpath:config/liquibase/changelog/automation/ai/eval/dataset" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        automation/ai/eval/experiment holds workspace_ai_eval_experiment — the membership table that FKs to
        ai_eval_experiment (in platform/ai/eval/experiment). Mirrors the workspace_ai_eval_dataset split.
    -->
    <includeAll path="classpath:config/liquibase/changelog/automation/ai/eval/experiment" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <!--
        automation/ai/prompt holds workspace_ai_prompt — the membership table that FKs to ai_prompt (in
        platform/ai/prompt). Mirrors the platform/ai/eval ↔ automation/ai/eval split.
    -->
    <includeAll path="classpath:config/liquibase/changelog/automation/ai/prompt" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/task" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/embedded/configuration/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/embedded/security/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/embedded/mcp/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/ai/agent_eval" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/ai/skill" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />

    <!-- execution -->
    <includeAll path="classpath:config/liquibase/changelog/atlas/execution/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/execution/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <!-- licence job usage -->
    <includeAll path="classpath:config/liquibase/changelog/platform/licence_job_usage/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or coordinator or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/data_entry/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/data_table/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/data_table/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/knowledge_base/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/knowledge_base/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/asset_file/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/context_store/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/automation/context_store/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/chat_memory" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />

    <!--
        automation/aihub is loaded AFTER automation/asset_file: the
        20260429120001_*_ai_hub_task_asset_file_init.xml changeset has a
        FK reference to asset_file(id), which is created under the `execution` context.
        Liquibase resolves changesets in master.xml document order regardless of which
        contexts gate them, so any deployment that runs both contexts (mono, multitenant)
        must see asset_file before automation/aihub. Kept under `configuration` contextFilter
        because the bulk of ai_hub tables (task, memory, usage) are still
        configuration-tier — only the join table touches asset_file.
    -->
    <!--
        platform/ai/auto/memory holds the shared ai_auto_memory table — extracted from CC's ai_hub_memory
        so any agent surface (AI Hub today, the future AI agent runtime) can reuse the same auto-curated
        long-term memory store.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/auto/memory" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />

    <includeAll path="classpath:config/liquibase/changelog/automation/aihub" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />

    <!--
        automation/aihub_execution holds the v2.2+ per-task tool persistence tables
        (ai_hub_task_component, ai_hub_task_tool). They live in
        aihub_execution/ rather than aihub/ because their FKs reach into the execution-tier
        connection(id) table — so they must be loaded under the `execution` context, after both
        automation/aihub/ (FK to ai_hub_task) and platform/execution/ (FK to connection).
    -->
    <includeAll path="classpath:config/liquibase/changelog/automation/aihub_execution" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or execution or multitenant" />

    <!--
        platform/ai/tool/usage holds the shared ai_tool_usage table used by every agent surface for tool-call
        metering (AI Hub today; the future AI agent runtime + ad-hoc tool runners next). Replaces the
        EE-only ai_hub_tool_usage; the column shape is mostly the same but task_id was generalised to
        owner_id (no FK) so the table can outlive any single owner type.
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/ai/tool/usage" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />

    <!-- billing -->
    <includeAll path="classpath:config/liquibase/changelog/platform/billing/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or multitenant" />

    <!--
        platform/tool/invocation/log holds tool_invocation_log, the append-only access log of direct action/tool
        executions (MCP component tools, workflow-as-tool calls, embedded public executeAction/executeTool).
    -->
    <includeAll path="classpath:config/liquibase/changelog/platform/tool/invocation/log" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or multitenant" />


    <!-- audit -->
    <includeAll path="classpath:config/liquibase/changelog/audit/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or configuration or connection or multitenant" />

    <!-- spring batch -->
    <includeAll path="classpath:config/liquibase/changelog/batch/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or batch" />

    <!-- quartz -->
    <includeAll path="classpath:config/liquibase/changelog/quartz/" relativeToChangelogFile="false" errorIfMissingOrEmpty="false" contextFilter="mono or scheduler" />
</databaseChangeLog>
