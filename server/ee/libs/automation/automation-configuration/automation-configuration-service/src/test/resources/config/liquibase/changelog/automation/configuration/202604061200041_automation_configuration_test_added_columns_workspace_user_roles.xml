<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        Test-only schema for the EE workspace_user role columns that WorkspaceUser maps (workspace_role,
        custom_role_id) and the chk_workspace_user_role_xor constraint. The production changelogs adding them
        (202604061200010 and 202604061200040) are not on this branch yet. Each changeSet is skipped when the
        production changelog has already created the object, so this file becomes inert once they land. The
        custom_role foreign key is left out because the custom_role table does not exist here.
    -->
    <changeSet id="202604061200041-1" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="workspace_user" columnName="workspace_role"/>
            </not>
        </preConditions>

        <addColumn tableName="workspace_user">
            <column name="workspace_role" type="INT" valueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="202604061200041-2" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="workspace_user" columnName="custom_role_id"/>
            </not>
        </preConditions>

        <addColumn tableName="workspace_user">
            <column name="custom_role_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="202604061200041-3" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_constraint WHERE conname = 'chk_workspace_user_role_xor'
            </sqlCheck>
        </preConditions>

        <sql>
            ALTER TABLE workspace_user ADD CONSTRAINT chk_workspace_user_role_xor
            CHECK ((workspace_role IS NOT NULL AND custom_role_id IS NULL) OR
                   (workspace_role IS NULL AND custom_role_id IS NOT NULL));
        </sql>
    </changeSet>
</databaseChangeLog>
