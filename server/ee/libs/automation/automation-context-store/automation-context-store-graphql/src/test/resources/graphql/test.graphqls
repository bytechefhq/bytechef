# Test-only GraphQL base operations for GraphQL slice tests in this module.

# Base operation types so that 'extend type Query/Mutation' from main resources can merge.
type Query {
    _placeholder: Boolean
}

type Mutation {
    _placeholder: Boolean
}

scalar Long

scalar Map

# Tag and TagInput are defined in platform-configuration-graphql; the GraphQL slice tests in this module don't pull
# that source set in, so the schema validator can't see them. Mirror the minimal shape here so the
# updateContextStoreTags mutation and contextStoreTags query resolve.
type Tag {
    id: ID!
    name: String!
}

input TagInput {
    id: ID
    name: String!
}
