<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        The empty <rollback/> blocks in this file are deliberate, not omissions.

        A changeset guarded by a MARK_RAN precondition can be recorded as ran without having applied its change, so
        its inverse must never run. With no rollback declared Liquibase auto-generates that inverse (dropColumn,
        dropTable, and so on) and a rollback would then destroy an object this changeset never created. An empty
        rollback leaves the object in place instead: inert, and re-applying the changeset is a no-op through the same
        precondition.
    -->

    <!--
        ai_prompt and ai_prompt_version tables themselves were extracted to platform/ai/prompt/. This changeset
        retains only the gateway-specific FKs from ai_observability_span to those tables, since ai_observability_span
        lives under automation/ai_gateway/ and the FK can only be installed once both ends exist.
    -->
    <changeSet id="00000000000003" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="ai_observability_span"/>
                <tableExists tableName="ai_prompt"/>
                <tableExists tableName="ai_prompt_version"/>
            </and>
        </preConditions>

        <addForeignKeyConstraint constraintName="fk_ai_obs_span_prompt"
                                 baseTableName="ai_observability_span" baseColumnNames="prompt_id"
                                 referencedTableName="ai_prompt" referencedColumnNames="id"/>

        <addForeignKeyConstraint constraintName="fk_ai_obs_span_prompt_version"
                                 baseTableName="ai_observability_span" baseColumnNames="prompt_version_id"
                                 referencedTableName="ai_prompt_version" referencedColumnNames="id"/>
        <rollback/>
    </changeSet>
</databaseChangeLog>
