<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Workspace ↔ ai_gateway_* relation tables. The entity tables (ai_gateway_provider, ai_gateway_model,
        ai_gateway_budget, ai_gateway_routing_policy, ai_gateway_model_deployment, ai_gateway_spend_summary,
        ai_gateway_project, ai_gateway_routing_policy_tag, ai_gateway_rate_limit) live in
        platform-ai-gateway-service under classpath:config/liquibase/changelog/platform/ai/gateway/ and are loaded
        BEFORE this file by master.xml — the FKs below depend on those tables existing.

        For upgraded databases that already ran the original monolithic 00000000000001 changeset (which also
        contained workspace_* tables alongside the entity tables before the platform/automation split), every
        changeset in this file has a MARK_RAN preCondition keyed on a representative table — the changeset is
        recorded as "run" without re-attempting the create.
    -->
    <changeSet id="20260507000010" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workspace_ai_gateway_spend_summary"/>
            </not>
        </preConditions>

        <createTable tableName="workspace_ai_gateway_spend_summary">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ai_gateway_spend_summary_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ws_ai_gw_spend_summary" references="ai_gateway_spend_summary(id)"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint constraintName="uk_ws_ai_gw_spend_summary" tableName="workspace_ai_gateway_spend_summary" columnNames="workspace_id,ai_gateway_spend_summary_id"/>

        <createIndex tableName="workspace_ai_gateway_spend_summary" indexName="idx_ws_ai_gw_spend_summary_workspace">
            <column name="workspace_id"/>
        </createIndex>

        <createTable tableName="workspace_ai_gateway_provider">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="provider_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ws_ai_llm_gw_provider" references="ai_gateway_provider(id)"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint constraintName="uk_ws_ai_llm_gw_provider" tableName="workspace_ai_gateway_provider" columnNames="workspace_id,provider_id"/>

        <createTable tableName="workspace_ai_gateway_routing_policy">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="routing_policy_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ws_ai_llm_gw_routing_policy" references="ai_gateway_routing_policy(id)"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint constraintName="uk_ws_ai_llm_gw_routing_policy" tableName="workspace_ai_gateway_routing_policy" columnNames="workspace_id,routing_policy_id"/>

        <createTable tableName="workspace_ai_gateway_budget">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ai_gateway_budget_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ws_ai_gw_budget_budget" references="ai_gateway_budget(id)"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint constraintName="uk_ws_ai_gw_budget" tableName="workspace_ai_gateway_budget" columnNames="workspace_id,ai_gateway_budget_id"/>
    </changeSet>

    <changeSet id="20260507000011" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workspace_ai_gateway_project"/>
            </not>
        </preConditions>

        <createTable tableName="workspace_ai_gateway_project">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ai_gateway_project_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ws_ai_gw_project_project" references="ai_gateway_project(id)"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint constraintName="uk_ws_ai_gw_project" tableName="workspace_ai_gateway_project" columnNames="workspace_id,ai_gateway_project_id"/>

        <createIndex tableName="workspace_ai_gateway_project" indexName="idx_ws_ai_gw_project_workspace">
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260507000012" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workspace_ai_gateway_rate_limit"/>
            </not>
        </preConditions>

        <createTable tableName="workspace_ai_gateway_rate_limit">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ai_gateway_rate_limit_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ws_ai_gw_rate_limit_rate_limit" references="ai_gateway_rate_limit(id)"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint constraintName="uk_ws_ai_gw_rate_limit" tableName="workspace_ai_gateway_rate_limit" columnNames="workspace_id,ai_gateway_rate_limit_id"/>

        <createIndex tableName="workspace_ai_gateway_rate_limit" indexName="idx_ws_ai_gw_rate_limit_workspace">
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
