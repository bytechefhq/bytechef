<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Workspace ↔ eval-entity relation tables. The eval entities themselves (ai_eval_rule, ai_eval_score,
        ai_eval_score_config) live in platform-ai-eval and are loaded by master.xml BEFORE this file —
        the FKs below depend on those tables existing.
    -->
    <changeSet id="20260601000001" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workspace_ai_eval_rule"/>
            </not>
        </preConditions>

        <createTable tableName="workspace_ai_eval_score">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ai_eval_score_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            constraintName="uk_workspace_ai_eval_score"
            tableName="workspace_ai_eval_score"
            columnNames="workspace_id, ai_eval_score_id"/>

        <createIndex tableName="workspace_ai_eval_score"
                     indexName="idx_workspace_ai_eval_score_workspace">
            <column name="workspace_id"/>
        </createIndex>

        <addForeignKeyConstraint
            baseTableName="workspace_ai_eval_score"
            baseColumnNames="ai_eval_score_id"
            constraintName="fk_workspace_ai_eval_score_score"
            referencedTableName="ai_eval_score"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createTable tableName="workspace_ai_eval_score_config">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ai_eval_score_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            constraintName="uk_workspace_ai_eval_score_config"
            tableName="workspace_ai_eval_score_config"
            columnNames="workspace_id, ai_eval_score_config_id"/>

        <createIndex tableName="workspace_ai_eval_score_config"
                     indexName="idx_workspace_ai_eval_score_config_workspace">
            <column name="workspace_id"/>
        </createIndex>

        <addForeignKeyConstraint
            baseTableName="workspace_ai_eval_score_config"
            baseColumnNames="ai_eval_score_config_id"
            constraintName="fk_workspace_ai_eval_score_config_config"
            referencedTableName="ai_eval_score_config"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createTable tableName="workspace_ai_eval_rule">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ai_eval_rule_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            constraintName="uk_workspace_ai_eval_rule"
            tableName="workspace_ai_eval_rule"
            columnNames="workspace_id, ai_eval_rule_id"/>

        <createIndex tableName="workspace_ai_eval_rule"
                     indexName="idx_workspace_ai_eval_rule_workspace">
            <column name="workspace_id"/>
        </createIndex>

        <addForeignKeyConstraint
            baseTableName="workspace_ai_eval_rule"
            baseColumnNames="ai_eval_rule_id"
            constraintName="fk_workspace_ai_eval_rule_rule"
            referencedTableName="ai_eval_rule"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
