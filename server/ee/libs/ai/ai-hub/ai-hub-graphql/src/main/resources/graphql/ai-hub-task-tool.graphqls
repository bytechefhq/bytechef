# Per-task tool persistence (v2.2 + v2.4 client UI).
#
# Two read shapes:
#   - aiHubTaskTools(...) returns the tools currently attached to a task, joined with their
#     parent component-binding context — this is what the task chip list renders.
#   - aiHubTaskToolableComponents(...) returns the catalog of components that have at least one
#     tool-typed cluster element, so the plus-button menu can show a hierarchical list.
#
# Three write shapes mirror the chat affordances (AttachTaskTool / RemoveTaskTool /
# updateToolParameters) so the UI and the LLM share one mutation surface.

type AiHubTaskToolBinding {
    taskToolId: ID!
    taskComponentId: ID!
    taskId: ID!
    componentName: String!
    componentVersion: Int!
    clusterElementName: String!
    connectionId: ID
    environment: Int!
    parameters: Any!
}

type ToolableComponent {
    componentName: String!
    componentVersion: Int!
    title: String
    description: String
    icon: String
    tools: [ToolableClusterElement!]!
    "Whether this component requires a connection to be used (drives the composer's Connect vs toggle affordance)."
    connectionRequired: Boolean!
}

type ToolableClusterElement {
    name: String!
    title: String
    description: String
}

extend type Query {
    """
    Lists every tool attached to the supplied task, joined with its parent component-binding
    context. Used by the task attached-tools chip list in the composer.
    """
    aiHubTaskTools(workspaceId: ID!, taskId: ID!): [AiHubTaskToolBinding!]!

    """
    Lists components that publish at least one tool-typed cluster element, with each component's tool
    catalog. Powers the composer plus-button menu's Tools section so users can browse the catalog
    without going through chat.
    """
    aiHubTaskToolableComponents(workspaceId: ID!): [ToolableComponent!]!

    """
    The current user's globally-added connectors (the Connectors page Pre-built list). Each carries the
    component metadata, its connection, the component-level enabled flag, and its tools with per-tool
    enabled flags.
    """
    aiHubUserConnectors(workspaceId: ID!): [AiHubUserConnector!]!
}

extend type Mutation {
    """
    Attach a tool to a task. Idempotent — re-attaching the same (component, action, connection)
    upserts the tool's parameters in place. Returns the persisted ids so the client can immediately
    address the row in subsequent updates / removes.
    """
    attachAiHubTaskTool(input: AttachAiHubTaskToolInput!): AiHubTaskToolBinding!

    """
    Update only the parameters of a previously attached tool (e.g. user adjusts the default channel
    after attach). Other fields on the binding (component, action, connection) are immutable post-attach;
    if the user wants to switch connection they should detach + reattach instead.
    """
    updateAiHubTaskToolParameters(workspaceId: ID!, taskToolId: ID!, parameters: Any!): AiHubTaskToolBinding!

    """
    Detach a single tool. Returns true on success; false when the id was not found (idempotent).
    """
    removeAiHubTaskTool(workspaceId: ID!, taskToolId: ID!): Boolean!

    """
    Detach a whole component binding (cascades to all its tools via the FK). Use when the user wants to
    remove all of e.g. Slack's tools at once instead of one at a time.
    """
    detachAiHubTaskComponent(workspaceId: ID!, taskComponentId: ID!): Boolean!

    """
    Add a pre-built connector to the current user's AI Hub (a user-global "added connector"). Idempotent —
    re-adding refreshes the connection in place. Returns the connector id.
    """
    addAiHubUserConnector(
        workspaceId: ID!, componentName: String!, componentVersion: Int!, connectionId: ID, environment: Int!
    ): ID!

    """Remove a user connector (cascades its tool config). Idempotent — returns false when not found/owned."""
    removeAiHubUserConnector(workspaceId: ID!, connectorId: ID!): Boolean!

    """Toggle a user connector on/off (the component-level enabled flag)."""
    setAiHubUserConnectorEnabled(workspaceId: ID!, connectorId: ID!, enabled: Boolean!): Boolean!

    """Toggle a single tool within a user connector on/off."""
    setAiHubUserConnectorToolEnabled(
        workspaceId: ID!, connectorId: ID!, toolName: String!, enabled: Boolean!
    ): Boolean!

    """Set the pre-configured parameter values for a single tool within a user connector."""
    setAiHubUserConnectorToolParameters(
        workspaceId: ID!, connectorId: ID!, toolName: String!, parameters: Any!
    ): Boolean!
}

type AiHubUserConnector {
    id: ID!
    componentName: String!
    componentVersion: Int!
    title: String
    description: String
    icon: String
    connectionId: ID
    connectionRequired: Boolean!
    enabled: Boolean!
    tools: [AiHubUserConnectorTool!]!
}

type AiHubUserConnectorTool {
    name: String!
    title: String
    description: String
    enabled: Boolean!
    parameters: Any
}

input AttachAiHubTaskToolInput {
    workspaceId: ID!
    taskId: ID!
    componentName: String!
    componentVersion: Int
    clusterElementName: String!
    connectionId: ID
    environment: Int!
    parameters: Any
}
