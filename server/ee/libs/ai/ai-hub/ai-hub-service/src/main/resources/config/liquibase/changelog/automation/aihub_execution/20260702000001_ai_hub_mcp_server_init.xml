<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        User-registered external MCP (Model Context Protocol) servers. Scoped per (user, workspace,
        environment) like the user-global "added connectors" in ai_hub_chat_component. The AI Hub agent
        connects OUT to `url` as an MCP client; `auth_token` holds an optional bearer token encrypted at
        rest (never returned to the client). Tool discovery + agent bridging land in a follow-up increment.
    -->
    <changeSet id="20260702000001" author="Ivica Cardic">
        <createTable tableName="ai_hub_mcp_server">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="environment" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="auth_token" type="VARCHAR(2048)">
                <constraints nullable="true"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)"/>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)"/>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ai_hub_mcp_server"
                     indexName="idx_ai_hub_mcp_server_user_workspace">
            <column name="user_id"/>
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
