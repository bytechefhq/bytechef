<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20260423000001" author="Ivica Cardic">
        <createTable tableName="ai_hub_chat">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="thread_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="last_preview" type="TEXT"/>
            <column name="message_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="INT">
                <constraints nullable="false"/>
            </column>
            <!-- Nullable on purpose: a chat belongs to at most one workspace, and null means none applies. -->
            <column name="workspace_id" type="BIGINT"/>
            <!-- Nullable: only chats that originate from an AI Agent's channel run (Slack, schedule, ...)
                 carry an owning agent id; composer-created chats leave it null. Attribution only -
                 thread_id's UNIQUE constraint above already scopes one chat per conversation, so this
                 column does not add or narrow any uniqueness. -->
            <column name="ai_agent_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Sidebar list query — the workspace dimension is the ai_hub_chat.workspace_id column. -->
        <createIndex tableName="ai_hub_chat"
                     indexName="idx_ai_hub_chat_user_status">
            <column name="user_id"/>
            <column name="status"/>
            <column name="updated_at" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
