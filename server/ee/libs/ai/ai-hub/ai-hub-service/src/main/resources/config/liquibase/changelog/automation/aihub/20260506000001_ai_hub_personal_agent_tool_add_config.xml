<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        Adds per-tool configuration to ai_hub_personal_agent_tool: a pinned connection_id and a
        parameters map. Mirrors the AI Agent simple-mode tools picker, where the user can pre-set a
        connection ("the sendMessage tool with the #engineering Slack workspace") AND pre-set parameters
        ("with channel #release-notes") so every task spawned from the agent starts with that
        exact binding.

        Why two separate columns instead of one config blob:

        - connection_id is a typed FK so a deleted connection sets the tool's binding to NULL (rather
          than leaving a string id that points at nothing). The task copy path can detect the
          NULL and fall back to "let the user pick at first invocation" — matches today's behaviour for
          tools without a pre-set connection.
        - parameters is a TEXT column holding a JSON-serialized map (matches the convention used by
          platform_connection.parameters and platform_mcp_tool.parameters). Spring Data JDBC reads TEXT
          as String, which the registered StringToMapWrapperConverter parses on the way to the entity's
          MapWrapper field. JSONB was tried first but fails with ConverterNotFoundException because no
          global PGobject → MapWrapper converter is registered. The task copy path is
          straightforward: AiHubPersonalAgentTool.parameters → AiHubTaskTool.parameters, no
          shape transformation.

        Lifecycle: existing rows get connection_id=NULL and parameters='{}' so the migration is
        non-breaking — agents created before this change continue to work exactly as before, just with
        the option to add per-tool config now available.

        Why not ON DELETE CASCADE on connection_id: a connection delete shouldn't cascade-remove the
        personal-agent-tool row — the agent's "I want to use Slack" intent is still valid, just
        unfulfilled until the user picks a new connection. ON DELETE SET NULL preserves the row + the
        component/operation context so the UI can prompt for a fresh connection.
    -->
    <changeSet id="20260506000001" author="Ivica Cardic">
        <addColumn tableName="ai_hub_personal_agent_tool">
            <column name="connection_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_ai_hub_personal_agent_tool_connection"
                             references="connection(id)"
                             deleteCascade="false"/>
            </column>
            <column name="parameters" type="TEXT" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!--
            Index on connection_id supports the "list every personal-agent-tool that pins this connection"
            reverse lookup the future "deleted-connection cleanup" job will need. Cheap to add now while
            the table is small; backfilling later requires a migration window.
        -->
        <createIndex tableName="ai_hub_personal_agent_tool"
                     indexName="idx_ai_hub_personal_agent_tool_connection">
            <column name="connection_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="ai_hub_personal_agent_tool" indexName="idx_ai_hub_personal_agent_tool_connection"/>
            <dropColumn tableName="ai_hub_personal_agent_tool" columnName="parameters"/>
            <dropColumn tableName="ai_hub_personal_agent_tool" columnName="connection_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
