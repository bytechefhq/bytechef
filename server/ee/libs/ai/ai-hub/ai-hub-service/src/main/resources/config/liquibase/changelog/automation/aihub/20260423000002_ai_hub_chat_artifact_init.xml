<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20260423000002" author="Ivica Cardic">
        <createTable tableName="ai_hub_chat_artifact">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chat_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_cc_artifact_chat"
                             references="ai_hub_chat(id)"
                             deleteCascade="true"/>
            </column>
            <column name="kind" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="artifact_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="artifact_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="metadata_json" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="status" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status_changed_at" type="TIMESTAMP"/>
            <column name="environment" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ai_hub_chat_artifact"
                     indexName="idx_cc_chat_artifact_chat">
            <column name="chat_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
