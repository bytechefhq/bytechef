            <column name="status" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="http_status" type="INT"/>
            <column name="error_message" type="TEXT"/>
            <column name="attempt_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="delivered_date" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_ai_obs_webhook_delivery_sub"
                                 baseTableName="ai_observability_webhook_delivery" baseColumnNames="subscription_id"
                                 referencedTableName="ai_observability_webhook_subscription" referencedColumnNames="id"/>

        <createIndex tableName="ai_observability_webhook_delivery" indexName="idx_ai_obs_webhook_delivery_sub">
            <column name="subscription_id"/>
        </createIndex>

        <createIndex tableName="ai_observability_webhook_delivery" indexName="idx_ai_obs_webhook_delivery_created">
            <column name="created_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
