<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261028000001" author="Ivica Cardic">
        <addColumn tableName="ai_agent_judge_verdict">
            <column name="status" type="INT"/>
            <column name="reason_code" type="VARCHAR(64)"/>
        </addColumn>

        <update tableName="ai_agent_judge_verdict">
            <column name="status" valueComputed="CASE WHEN passed THEN 0 ELSE 1 END"/>
        </update>

        <dropNotNullConstraint tableName="ai_agent_judge_verdict" columnName="score"
                               columnDataType="DOUBLE PRECISION"/>

        <addColumn tableName="ai_agent_eval_result">
            <column name="conclusion" type="INT"/>
        </addColumn>

        <update tableName="ai_agent_eval_result">
            <column name="conclusion" valueComputed="CASE WHEN score &gt;= 1.0 THEN 0 ELSE 1 END"/>
            <where>score IS NOT NULL</where>
        </update>
    </changeSet>
</databaseChangeLog>
