<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261029000001" author="Ivica Cardic">
        <update tableName="ai_agent_judge_verdict">
            <column name="status" valueComputed="CASE WHEN passed THEN 0 ELSE 1 END"/>
            <where>status IS NULL</where>
        </update>

        <addNotNullConstraint tableName="ai_agent_judge_verdict" columnName="status" columnDataType="INT"/>

        <dropColumn tableName="ai_agent_judge_verdict" columnName="passed"/>

        <update tableName="ai_agent_eval_result">
            <column name="conclusion" valueComputed="CASE WHEN score &gt;= 1.0 THEN 0 ELSE 1 END"/>
            <where>conclusion IS NULL AND status = 2 AND score IS NOT NULL</where>
        </update>
    </changeSet>
</databaseChangeLog>
