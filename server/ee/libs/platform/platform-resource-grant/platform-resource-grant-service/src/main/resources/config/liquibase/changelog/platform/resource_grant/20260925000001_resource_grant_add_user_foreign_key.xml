<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20260925000001-01" author="Ivica Cardic" contextFilter="mono">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user"/>
        </preConditions>

        <sql>DELETE FROM resource_grant WHERE user_id NOT IN (SELECT id FROM "user")</sql>

        <addForeignKeyConstraint
            baseTableName="resource_grant"
            baseColumnNames="user_id"
            constraintName="fk_resource_grant_user"
            referencedTableName="user"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
