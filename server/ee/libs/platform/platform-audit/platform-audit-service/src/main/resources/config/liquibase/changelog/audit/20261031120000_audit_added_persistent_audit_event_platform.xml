<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20261031120000" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="persistent_audit_event" columnName="platform"/>
            </not>
        </preConditions>

        <addColumn tableName="persistent_audit_event">
            <column name="platform" type="VARCHAR(32)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20261031120001" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_persistent_audit_event_platform_event_date"/>
            </not>
        </preConditions>

        <createIndex indexName="idx_persistent_audit_event_platform_event_date" tableName="persistent_audit_event">
            <column name="platform"/>
            <column name="event_date" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
