extend type Query {
    users(pageNumber: Int, pageSize: Int): AdminUserPage
    user(login: String!): AdminUser
}

extend type Mutation {
    deleteUser(login: String!): Boolean!
    """
    Provision a tenant account and mail a claim link on which the recipient sets their own password.
    Optionally place the invitee into workspaces; an empty or omitted list provisions an account
    belonging to no workspace, which is how a second tenant admin is created.
    """
    inviteUser(email: String!, role: String!, workspaces: [WorkspaceAssignmentInput!]): Boolean!
    updateUser(login: String!, role: String!): AdminUser!
}

input WorkspaceAssignmentInput {
    workspaceId: ID!
    "WorkspaceRole name, e.g. ADMIN, EDITOR or VIEWER"
    roleName: String!
}

type AdminUser {
    id: ID
    uuid: String
    login: String
    firstName: String
    lastName: String
    email: String
    imageUrl: String
    activated: Boolean
    langKey: String
    createdBy: String
    createdDate: Long
    lastModifiedBy: String
    lastModifiedDate: Long
    authorities: [String]
}

type AdminUserPage {
    content: [AdminUser]!
    totalElements: Int!
    totalPages: Int!
    number: Int!
    size: Int!
}
