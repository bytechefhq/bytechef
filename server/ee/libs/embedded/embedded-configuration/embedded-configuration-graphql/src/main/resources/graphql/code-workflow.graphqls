# CodeWorkflowLanguage is defined in the automation module's schema
# (automation-configuration-graphql/src/main/resources/graphql/code-workflow.graphqls). This module must be
# co-deployed with it (server-app and configuration-app always are today).
extend type Query {
    integrationCodeWorkflowSource(integrationId: ID!): String!
}

extend type Mutation {
    updateIntegrationCodeWorkflowSource(integrationId: ID!, content: String!): Boolean!
    createIntegrationCodeWorkflow(componentName: String!, language: CodeWorkflowLanguage!, name: String, description: String, categoryId: ID, tags: [String!], permissionExpression: String): ID!
}
