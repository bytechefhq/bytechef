type AutomationWorkflowProjectConfiguration {
    id: ID!
    projectId: ID!
    environmentId: ID!
    name: String!
    permissionExpression: String
    connectedUserCount: Int!
    projectVersion: Int!
    enabled: Boolean!
    automationHubVisible: Boolean!
    lastModifiedDate: String
    lastExecutionDate: String
    workflows: [AutomationWorkflowProjectConfigurationWorkflow!]!
}

type AutomationWorkflowProjectConfigurationWorkflow {
    workflowUuid: ID!
    workflowId: ID!
    label: String
    enabled: Boolean!
    lastExecutionDate: String
    providedConnections: Map
    providedInputs: Map
}

type AutomationWorkflowProjectConfigurationWorkflowProvidableValues {
    connectionSlots: [AutomationWorkflowProjectConfigurationConnectionSlot!]!
    inputs: [AutomationWorkflowProjectConfigurationInput!]!
    providedConnections: Map
    providedInputs: Map
}

type AutomationWorkflowProjectConfigurationConnectionSlot {
    componentName: String!
    title: String!
    required: Boolean!
    providableConnections: [AutomationWorkflowProjectConfigurationProvidableConnection!]!
}

type AutomationWorkflowProjectConfigurationProvidableConnection {
    id: ID!
    name: String!
}

type AutomationWorkflowProjectConfigurationInput {
    name: String!
    label: String
    type: String
    required: Boolean!
    componentName: String
    componentVersion: Int
    groupName: String
    optionConnections: [AutomationWorkflowProjectConfigurationProvidableConnection!]!
}

type AutomationWorkflowProjectConfigurationInputOption {
    label: String
    value: String!
    description: String
}

type AutomationWorkflowProjectConfigurationVersionImpact {
    workflows: [AutomationWorkflowProjectConfigurationVersionImpactWorkflow!]!
}

type AutomationWorkflowProjectConfigurationVersionImpactWorkflow {
    workflowUuid: ID!
    label: String!
    newRequiredInputs: [String!]!
    newRequiredConnections: [String!]!
    affectedConnectedUserCount: Int!
}

type AutomationWorkflowProjectConfigurationDeleteImpact {
    connectedUserCount: Int!
    referenceWorkflowCount: Int!
}

type AutomationWorkflowProjectConfigurationConnectedUser {
    connectedUserId: ID!
    externalId: String!
    name: String
    email: String
}

type AutomationWorkflowProjectConfigurationMoveImpact {
    workflows: [AutomationWorkflowProjectConfigurationVersionImpactWorkflow!]!
    skipped: [ConfigurationMoveSkipped!]!
}

type ConfigurationMoveResult {
    movedConnectedUserIds: [ID!]!
    needsAttentionConnectedUserIds: [ID!]!
    skipped: [ConfigurationMoveSkipped!]!
}

type ConfigurationMoveSkipped {
    connectedUserId: ID!
    reason: String!
    workflowLabels: [String!]!
}

extend type Query {
    automationWorkflowProjectConfigurations(projectId: ID!, environmentId: ID): [AutomationWorkflowProjectConfiguration!]!
    automationWorkflowProjectConfigurationWorkflowProvidableValues(id: ID!, workflowUuid: ID!): AutomationWorkflowProjectConfigurationWorkflowProvidableValues!
    automationWorkflowProjectConfigurationWorkflowInputOptions(id: ID!, workflowUuid: ID!, inputName: String!, propertyName: String!, connectionId: ID!, lookupDependsOnValues: Map, searchText: String): [AutomationWorkflowProjectConfigurationInputOption!]!
    automationWorkflowProjectConfigurationVersionImpact(id: ID!, projectVersion: Int!): AutomationWorkflowProjectConfigurationVersionImpact!
    automationWorkflowProjectConfigurationDeleteImpact(id: ID!): AutomationWorkflowProjectConfigurationDeleteImpact!
    automationWorkflowProjectConfigurationConnectedUsers(id: ID!): [AutomationWorkflowProjectConfigurationConnectedUser!]!
    automationWorkflowProjectConfigurationMoveImpact(sourceId: ID!, targetId: ID!, connectedUserIds: [ID!]!): AutomationWorkflowProjectConfigurationMoveImpact!
}

extend type Mutation {
    createAutomationWorkflowProjectConfiguration(projectId: ID!, environmentId: ID!, name: String!, permissionExpression: String, projectVersion: Int!, enabled: Boolean!, automationHubVisible: Boolean!): ID!
    updateAutomationWorkflowProjectConfiguration(id: ID!, name: String!, permissionExpression: String, projectVersion: Int!, enabled: Boolean!, automationHubVisible: Boolean!): Boolean!
    deleteAutomationWorkflowProjectConfiguration(id: ID!): Boolean!
    enableAutomationWorkflowProjectConfiguration(id: ID!, enable: Boolean!): Boolean!
    enableAutomationWorkflowProjectConfigurationWorkflow(id: ID!, workflowUuid: ID!, enable: Boolean!): Boolean!
    moveAutomationWorkflowProjectConfigurationConnectedUsers(sourceId: ID!, targetId: ID!, connectedUserIds: [ID!]!): ConfigurationMoveResult!
    updateAutomationWorkflowProjectConfigurationWorkflow(id: ID!, workflowUuid: ID!, providedConnections: Map, providedInputs: Map): Boolean!
}
