type AutomationWorkflowProjectConfiguration {
    id: ID!
    projectId: ID!
    environmentId: ID!
    projectVersion: Int!
    enabled: Boolean!
    automationHubVisible: Boolean!
    lastModifiedDate: String
    lastExecutionDate: String
    workflows: [AutomationWorkflowProjectConfigurationWorkflow!]!
}

type AutomationWorkflowProjectConfigurationWorkflow {
    workflowUuid: ID!
    workflowId: ID!
    label: String
    enabled: Boolean!
    lastExecutionDate: String
}

type AutomationWorkflowProjectConfigurationVersionImpact {
    workflows: [AutomationWorkflowProjectConfigurationVersionImpactWorkflow!]!
}

type AutomationWorkflowProjectConfigurationVersionImpactWorkflow {
    workflowUuid: ID!
    label: String!
    newRequiredInputs: [String!]!
    newRequiredConnections: [String!]!
    affectedConnectedUserCount: Int!
}

extend type Query {
    automationWorkflowProjectConfigurations(projectId: ID!): [AutomationWorkflowProjectConfiguration!]!
    automationWorkflowProjectConfigurationVersionImpact(id: ID!, projectVersion: Int!): AutomationWorkflowProjectConfigurationVersionImpact!
}

extend type Mutation {
    createAutomationWorkflowProjectConfiguration(projectId: ID!, environmentId: ID!, projectVersion: Int!, enabled: Boolean!, automationHubVisible: Boolean!): ID!
    updateAutomationWorkflowProjectConfiguration(id: ID!, projectVersion: Int!, enabled: Boolean!, automationHubVisible: Boolean!): Boolean!
    deleteAutomationWorkflowProjectConfiguration(id: ID!): Boolean!
    enableAutomationWorkflowProjectConfiguration(id: ID!, enable: Boolean!): Boolean!
    enableAutomationWorkflowProjectConfigurationWorkflow(id: ID!, workflowUuid: ID!, enable: Boolean!): Boolean!
}
