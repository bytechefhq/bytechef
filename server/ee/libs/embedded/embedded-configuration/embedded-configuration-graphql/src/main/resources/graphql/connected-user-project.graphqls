extend type Query {
    connectedUserProjects(connectedUserId: ID, environmentId: ID): [ConnectedUserProject!]!
    provisionableConnectedUserProjects(connectedUserId: ID!): [ProvisionableConnectedUserProject!]!
}

extend type Mutation {
    deleteConnectedUserProjectWorkflow(id: ID!): Boolean
    enableConnectedUserProjectWorkflow(id: ID!, enable: Boolean!): Boolean
    provisionConnectedUserProjectWorkflows(
        connectedUserId: ID!, configurationId: ID!, workflows: [ProvisionConnectedUserProjectWorkflowInput!]!
    ): Boolean
}

type ConnectedUserProject {
    id: ID!
    connectedUser: ConnectedUser!
    environmentId: ID!
    lastExecutionDate: String
    projectId: ID!
    connectedUserProjectWorkflows: [ConnectedUserProjectWorkflow!]!
    projectVersion: Int
    automationProjectConfigurations: [ConnectedUserAutomationProjectConfiguration!]!
    createdBy: String
    createdDate: String
    lastModifiedBy: String
    lastModifiedDate: String
    version: Int
}

type ConnectedUserAutomationProjectConfiguration {
    projectId: ID!
    configurationId: ID!
    configurationName: String!
    configurationProjectVersion: Int!
}

type ConnectedUserProjectWorkflow {
    id: ID!
    automationWorkflowUuid: ID
    connectedUserId: ID!
    copiedFromWorkflowUuid: ID
    enabled: Boolean!
    lastExecutionDate: String
    projectId: ID!
    staticWebhookUrl: String
    workflow: Workflow!
    workflowUuid: ID!
    workflowVersion: Int
    createdBy: String
    createdDate: String
    lastModifiedBy: String
    lastModifiedDate: String
    version: Int
}


type ProvisionableConnectedUserProject {
    projectId: ID!
    name: String!
    projectVersion: Int!
    workflows: [ProvisionableConnectedUserProjectWorkflow!]!
    configurations: [ProvisionableConnectedUserProjectConfiguration!]!
    assignedConfigurationId: ID
}

type ProvisionableConnectedUserProjectConfiguration {
    id: ID!
    name: String!
    projectVersion: Int!
    selfServe: Boolean!
    workflows: [ProvisionableConnectedUserProjectWorkflow!]!
}

type ProvisionableConnectedUserProjectWorkflow {
    workflowUuid: ID!
    label: String
    inputs: [ProvisionableConnectedUserProjectWorkflowInputDefinition!]!
    provisioned: Boolean!
    dangling: Boolean!
}

type ProvisionableConnectedUserProjectWorkflowInputDefinition {
    name: String!
    label: String
    type: String
    required: Boolean!
}

input ProvisionConnectedUserProjectWorkflowInput {
    workflowUuid: ID!
    inputs: Map
}
