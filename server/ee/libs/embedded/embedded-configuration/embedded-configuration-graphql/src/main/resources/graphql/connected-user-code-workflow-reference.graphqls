type ConnectedUserCodeWorkflowReference {
    catalogWorkflowUuid: ID!
    externalUserId: String!
    environment: String!
    enabled: Boolean!
    dangling: Boolean!
    danglingReason: String
}

extend type Query {
    connectedUserCodeWorkflowReferences(catalogWorkflowUuids: [ID!]!): [ConnectedUserCodeWorkflowReference!]!
}
