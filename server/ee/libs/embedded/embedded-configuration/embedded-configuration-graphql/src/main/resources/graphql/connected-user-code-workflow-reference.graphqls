type ConnectedUserCodeWorkflowReference {
    automationUuid: ID!
    externalUserId: String!
    environment: String!
    enabled: Boolean!
    dangling: Boolean!
    danglingReason: String
}

extend type Query {
    connectedUserCodeWorkflowReferences(automationUuids: [ID!]!): [ConnectedUserCodeWorkflowReference!]!
}
