type ConnectedUserCodeWorkflowReference {
    automationWorkflowUuid: ID!
    externalUserId: String!
    environment: String!
    enabled: Boolean!
    dangling: Boolean!
    danglingReason: String
}

extend type Query {
    connectedUserCodeWorkflowReferences(automationWorkflowUuids: [ID!]!): [ConnectedUserCodeWorkflowReference!]!
}
