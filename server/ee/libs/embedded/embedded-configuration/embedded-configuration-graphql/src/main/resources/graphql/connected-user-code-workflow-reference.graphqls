type ConnectedUserCatalogWorkflowCopy {
    copiedFromWorkflowUuid: ID!
    workflowUuid: ID!
    externalUserId: String!
    connectedUserName: String
    connectedUserEmail: String
    enabled: Boolean!
}

type ConnectedUserCodeWorkflowReference {
    automationWorkflowUuid: ID!
    externalUserId: String!
    environment: String!
    enabled: Boolean!
    dangling: Boolean!
    danglingReason: String
}

extend type Query {
    connectedUserCatalogWorkflowCopies(
        automationWorkflowUuids: [ID!]!, environmentId: ID!
    ): [ConnectedUserCatalogWorkflowCopy!]!

    connectedUserCodeWorkflowReferences(
        automationWorkflowUuids: [ID!]!, environmentId: ID!
    ): [ConnectedUserCodeWorkflowReference!]!
}
