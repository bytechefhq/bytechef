extend type Query {
    connectedUserMcpServers(connectedUserId: ID!): [ConnectedUserMcpServer!]!
    provisionableConnectedUserMcpServers(connectedUserId: ID!): [ProvisionableConnectedUserMcpServer!]!
}

extend type Mutation {
    deleteConnectedUserMcpServer(connectedUserId: ID!, mcpServerId: ID!): Boolean
    enableConnectedUserMcpServer(connectedUserId: ID!, mcpServerId: ID!, enable: Boolean!): Boolean
    enableConnectedUserMcpTool(id: ID!, enable: Boolean!): Boolean
    provisionConnectedUserMcpServer(connectedUserId: ID!, mcpServerId: ID!): Boolean
}

type ProvisionableConnectedUserMcpServer {
    id: ID!
    name: String!
    provisioned: Boolean!
    coveredComponentNames: [String!]!
    missingComponentNames: [String!]!
}

type ConnectedUserMcpServer {
    id: ID!
    name: String!
    enabled: Boolean!
    environmentId: ID!
    lastModifiedDate: String
    tools: [ConnectedUserMcpServerTool!]!
    workflows: [ConnectedUserMcpServerWorkflow!]!
}

type ConnectedUserMcpServerTool {
    id: ID!
    componentName: String!
    componentVersion: Int!
    integrationInstanceId: ID!
    name: String!
    enabled: Boolean!
}

type ConnectedUserMcpServerWorkflow {
    integrationInstanceId: ID!
    componentName: String!
    integrationVersion: Int!
    workflowId: String!
    name: String!
    description: String
    enabled: Boolean!
    lastExecutionDate: String
}
