<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="20261113000002" author="Ivica Cardic">
        <createTable tableName="mcp_integration_instance_workflow">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="integration_instance_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="mcp_integration_instance_configuration_workflow_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="mcp_integration_instance_workflow"
            baseColumnNames="integration_instance_id"
            constraintName="fk_mcp_integration_instance_workflow_integration_instance"
            referencedTableName="integration_instance"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="mcp_integration_instance_workflow"
            baseColumnNames="mcp_integration_instance_configuration_workflow_id"
            constraintName="fk_mcp_integration_instance_workflow_mcp_iicw"
            referencedTableName="mcp_integration_instance_configuration_workflow"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addUniqueConstraint
            tableName="mcp_integration_instance_workflow"
            columnNames="integration_instance_id, mcp_integration_instance_configuration_workflow_id"
            constraintName="uk_mcp_integration_instance_workflow"/>

        <createIndex tableName="mcp_integration_instance_workflow"
                     indexName="idx_mcp_integration_instance_workflow_mcp_iicw_id">
            <column name="mcp_integration_instance_configuration_workflow_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
