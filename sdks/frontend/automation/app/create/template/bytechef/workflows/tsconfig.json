{
    "include": ["*.ts"],
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleDetection": "legacy",
        "lib": ["ES2022"],
        "types": [],
        "outDir": "dist",
        "removeComments": true,

        /* A code workflow file is one bare ({ ... }) expression: never import or export */
        "strict": true,
        "alwaysStrict": false,
        "noImplicitAny": false,
        "skipLibCheck": true
    }
}
